Module[{a,b,c,x,y,lam,k,us,up,ua,total,expected,checks},k={{a+b,-b},{-c,c+lam (x+y)}};us=Simplify[LinearSolve[k,{0,lam x}]];up=Simplify[LinearSolve[k,{0,lam y}]];ua=Simplify[LinearSolve[k,{a,0}]];total=Simplify[us+up];expected=lam (x+y) {b,a+b}/(a c+(a+b) lam (x+y));checks={FullSimplify[us+up+ua=={1,1}],FullSimplify[total==expected],FullSimplify[Limit[total/lam,lam->0]==(x+y) {b,a+b}/(a c)],FullSimplify[And@@Thread[D[total,lam]>=0],Assumptions->a>0&&b>0&&c>0&&x>=0&&y>=0&&lam>=0],FullSimplify[And@@Thread[D[total,{lam,2}]<=0],Assumptions->a>0&&b>0&&c>0&&x>=0&&y>=0&&lam>=0]};ExportString[<|"model"->"two transient states; absorption a, upward b, downward c; only high state marked", "checks"->checks,"CE_total"->ToString[total,InputForm],"channel_S"->ToString[us,InputForm],"absorption"->ToString[ua,InputForm],"small_lambda_slope"->ToString[Simplify[Limit[total/lam,lam->0]],InputForm]|>,"RawJSON"]]
