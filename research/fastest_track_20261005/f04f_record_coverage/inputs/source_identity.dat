//! Static FT03 first canonical interval: atomic accepted trials and exact resume.
use rei_microphysics::{
    certified_ft03_trial, Ft03Events, Ft03Model, HHeState, Interval, RootSite, StepControl,
    FT03_MODEL_ID,
};
use std::{
    env,
    fmt::Write as FmtWrite,
