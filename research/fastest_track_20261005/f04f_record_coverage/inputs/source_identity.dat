#[derive(Debug, Clone)]
pub struct State {
    pub n_comoving_per_cmpc3: [f64; 4],
    pub x_hii: f64,
    /// HeI, HeII, HeIII fractions.
    pub helium: [f64; 3],
    pub u_erg_per_cm3: f64,
