   195	def _strict_witness(witness,cfg,raw,canonical_initial):
   196	    for key in ('array_digest_match','norm_match','environment_match','numerical_state_substituted','numerical_state_renormalized'):
   197	        if type(witness.get(key)) is not bool:raise ValueError('witness Boolean field type mismatch: '+key)
   198	    validate_witness(witness,cfg)
   199	    if witness['prepared_array_digest']!=INITIAL_ARRAY:
   200	        raise ValueError('canonical initial array digest mismatch')
   201	    if canonical(raw['initial'])!=canonical(canonical_initial) or canonical(witness.get('initial_metadata'))!=canonical(canonical_initial):
   202	        raise ValueError('canonical initial metadata mismatch')
   203	    if witness.get('dtype')!='<c16' or canonical(witness.get('shape'))!=canonical([350,300,600]) or witness.get('backend')!='cupy':
   204	        raise ValueError('initial array shape/dtype/backend mismatch')
   205	    dv=number(witness.get('dv'),'witness dv',positive=True)
   206	    if not math.isclose(dv,.2**3,rel_tol=2e-14):raise ValueError('witness grid weighting mismatch')
   207	    norms=[number(witness.get(k),k,positive=True) for k in ('prepared_norm','internal_norm')]
   208	    if not math.isclose(norms[0],norms[1],rel_tol=1e-12) or not math.isclose(norms[0],1.,abs_tol=1e-10):
   209	        raise ValueError('witness normalization mismatch')
   210	    if not isinstance(witness.get('prepared_receipt_sha256'),str) or not re.fullmatch('[0-9a-f]{64}',witness['prepared_receipt_sha256']):
   211	        raise ValueError('prepared receipt digest missing')
