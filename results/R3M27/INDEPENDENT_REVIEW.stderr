   101	
   102	def ndarray_digest(array) -> str:
   103	    """Typed SHA-256 over dtype, shape, and C-order numerical bytes."""
   104	    arr = np.asarray(array)
   105	    if arr.dtype.hasobject or not np.isfinite(arr).all():
   106	        raise ValueError("finite non-object numerical array required")
   107	
   108	    h = hashlib.sha256()
   109	    h.update(b"BASS_CR_NDARRAY_SHA256_V1\0")
   110	    h.update(arr.dtype.str.encode("ascii") + b"\0")
   111	    h.update(
   112	        json.dumps(list(arr.shape), separators=(",", ":")).encode("ascii") + b"\0"
   113	    )
   114	
   115	    if arr.flags.c_contiguous:
   116	        raw = memoryview(arr).cast("B")
   117	        for offset in range(0, len(raw), HASH_CHUNK_BYTES):
   118	            h.update(raw[offset : offset + HASH_CHUNK_BYTES])
   119	    else:
   120	        for slab in arr:
   121	            h.update(np.ascontiguousarray(slab).view(np.uint8).tobytes())
   122	    return h.hexdigest()
   123	
   124	
   125	def weighted_norm(array, dv: float) -> float:
   126	    arr = np.asarray(array).reshape(-1)
   127	    partials = []
   128	    for offset in range(0, arr.size, NORM_CHUNK_ELEMENTS):
   129	        chunk = arr[offset : offset + NORM_CHUNK_ELEMENTS]
   130	        partials.append(float(np.vdot(chunk, chunk).real) * dv)
   131	    return math.fsum(partials)
   132	
   133	
   134	def validate_prepared(
   135	    prepared_dir: Path,
   136	    raw_cfg: dict,
   137	    expected_source_digest: str,
   138	) -> dict:
   139	    """Validate preparation through the canonical R3M13 loader, then add bindings."""
   140	    prepared_dir = Path(prepared_dir)
   141	    helper = load_r3m13_helper()
   142	
   143	    if getattr(helper, "EXPECTED_SOURCE_DIGEST", None) != expected_source_digest:
   144	        raise ValueError("R3M13 helper source pin mismatch")
   145	
   146	    # SSOT reuse: this verifies R3M13 status/source, dynamics_fingerprint,
   147	    # initial.npy file hash, grid shape, and dv exactly as R3M13 defined them.
   148	    state, receipt = helper.load_prepared(prepared_dir)
   149	
   150	    if receipt.get("schema") != "BASS_CR_R3M13_PREPARATION_V1":
   151	        raise ValueError("unexpected R3M13 preparation schema")
   152	    helper_sha = file_sha(R3M13_HELPER)
   153	    if receipt.get("script_sha256") != helper_sha:
   154	        raise ValueError("R3M13 helper script hash mismatch")
   155	    if canonical_json(receipt.get("config")) != canonical_json(raw_cfg):
   156	        raise ValueError("prepared-state canonical config differs from collision config")
   157	
   158	    dv = float(receipt["dv"])
   159	    norm = weighted_norm(state, dv)
   160	    if abs(norm - 1.0) > NORM_TOL:
   161	        raise ValueError("prepared state is not normalized in its grid measure")
   162	
   163	    return {
   164	        "receipt": receipt,
   165	        "receipt_sha256": file_sha(prepared_dir / "receipt.json"),
   166	        "state_file_sha256": file_sha(prepared_dir / "initial.npy"),
   167	        "array_digest": ndarray_digest(state),
   168	        "shape": list(state.shape),
   169	        "dtype": state.dtype.str,
   170	        "dv": dv,
   171	        "norm": norm,
   172	        "helper_sha256": helper_sha,
   173	    }
   174	
   175	
   176	class WitnessControlledTDLRunner(ControlledTDLRunner):
   177	    """Observe and bind the inherited initial state without modifying it."""
   178	
   179	    def __init__(
   180	        self,
   181	        cfg,
   182	        *,
   183	        collision_out: Path,
   184	        prepared_info: dict,
   185	        expected_source_digest: str,
   186	        instrumentation_sha256: str,
   187	    ):
   188	        self._witness_out = Path(collision_out)
   189	        self._prepared_info = prepared_info
   190	        self._expected_source_digest = expected_source_digest
   191	        self._instrumentation_sha256 = instrumentation_sha256
   192	        super().__init__(cfg)
   193	
   194	    def relaxed_initial(self):
   195	        psi, info = super().relaxed_initial()
   196	        host = np.asarray(asnumpy(psi))
   197	        internal_digest = ndarray_digest(host)
   198	        internal_norm = weighted_norm(host, self.dv)
   199	
   200	        prepared_env = self._prepared_info["receipt"].get("environment", {})
   201	        runtime_env = runtime_environment(self.backend)
   202	        # R3M13 records exactly these three fields. Extra CUDA/CuPy identity is
   203	        # bound separately across collision restarts below.
   204	        environment_match = all(
   205	            prepared_env.get(key) == runtime_env.get(key)
   206	            for key in ("python", "numpy", "backend")
   207	        )
   208	        digest_match = internal_digest == self._prepared_info["array_digest"]
   209	        norm_match = abs(internal_norm - 1.0) <= NORM_TOL
   210	        same = digest_match and environment_match and norm_match
   211	
   212	        witness = {
   213	            "schema": SCHEMA,
   214	            "status": (
   215	                "PASS_BYTE_IDENTICAL_INTERNAL_INITIAL_TO_PREPARED"
   216	                if same
   217	                else "FAIL_INTERNAL_INITIAL_NOT_IDENTICAL"
   218	            ),
   219	            "numerical_state_substituted": False,
   220	            "numerical_state_renormalized": False,
   221	            "collision_propagation_started_when_written": False,
   222	            "expected_source_digest": self._expected_source_digest,
   223	            "actual_source_digest": source_digest(),
   224	            "instrumentation_sha256": self._instrumentation_sha256,
   225	            "r3m13_helper_sha256": self._prepared_info["helper_sha256"],
   226	            "prepared_receipt_sha256": self._prepared_info["receipt_sha256"],
   227	            "prepared_state_file_sha256": self._prepared_info["state_file_sha256"],
   228	            "prepared_array_digest": self._prepared_info["array_digest"],
   229	            "internal_array_digest": internal_digest,
   230	            "array_digest_match": digest_match,
   231	            "prepared_norm": self._prepared_info["norm"],
   232	            "internal_norm": internal_norm,
   233	            "norm_match": norm_match,
   234	            "prepared_environment": prepared_env,
   235	            "runtime_environment": runtime_env,
   236	            "environment_match": environment_match,
   237	            "shape": list(host.shape),
   238	            "dtype": host.dtype.str,
   239	            "dv": self.dv,
   240	            "backend": self.backend,
   241	            "enriched_config_hash": config_hash(self.cfg),
   242	            "initial_metadata": info,
   243	            "physical_rate_evaluated": False,
   244	            "bgrid": "NO_GO",
   245	            "claim_scope": "IDENTITY_BINDING_ONLY_NOT_CONVERGENCE",
   246	        }
   247	        atomic_json(self._witness_out / "r3m14_initial_binding.json", witness)
   248	
   249	        if not same:
   250	            raise ValueError(
   251	                "actual collision initial state is not "
   252	                "byte-identical/environment-bound to prepared initial state"
   253	            )
   254	        # Critical noninterference property: return the inherited object exactly.
   255	        return psi, info
   256	
   257	
   258	def validate_resume(
   259	    out: Path,
   260	    prepared_info: dict,
   261	    runner: ControlledTDLRunner,
   262	    expected_source_digest: str,
   263	    instrumentation_sha256: str,
   264	):
   265	    witness_path = out / "r3m14_initial_binding.json"
   266	    if not witness_path.is_file():
   267	        raise ValueError("existing collision checkpoint lacks R3M14 initial binding witness")
   268	    witness = load_json(witness_path)
   269	    if (
   270	        witness.get("schema") != SCHEMA
   271	        or witness.get("status")
   272	        != "PASS_BYTE_IDENTICAL_INTERNAL_INITIAL_TO_PREPARED"
   273	    ):
   274	        raise ValueError("initial binding witness is not PASS")
   275	
   276	    checks = {
   277	        "expected_source_digest": expected_source_digest,
   278	        "actual_source_digest": source_digest(),
   279	        "instrumentation_sha256": instrumentation_sha256,
   280	        "r3m13_helper_sha256": prepared_info["helper_sha256"],
   281	        "prepared_receipt_sha256": prepared_info["receipt_sha256"],
   282	        "prepared_state_file_sha256": prepared_info["state_file_sha256"],
   283	        "prepared_array_digest": prepared_info["array_digest"],
   284	        "enriched_config_hash": config_hash(runner.cfg),
   285	        "runtime_environment": runtime_environment(runner.backend),
   286	    }
   287	    for key, expected in checks.items():
   288	        if witness.get(key) != expected:
   289	            raise ValueError(f"resume binding mismatch: {key}")
   290	    return witness
   291	
   292	
   293	def run_bound(
   294	    config_path: Path,
   295	    prepared_dir: Path,
   296	    out: Path,
   297	    max_steps: int | None,
   298	    expected_source_digest: str = EXPECTED_SOURCE_DIGEST,
   299	):
   300	    if source_digest() != expected_source_digest:
   301	        raise ValueError("unexpected cr_repro source digest")
   302	
   303	    raw_cfg = load_json(config_path)
   304	    prepared = validate_prepared(prepared_dir, raw_cfg, expected_source_digest)
   305	    out = Path(out)
   306	    script_sha = file_sha(Path(__file__))
   307	    runner = WitnessControlledTDLRunner(
   308	        raw_cfg,
   309	        collision_out=out,
   310	        prepared_info=prepared,
   311	        expected_source_digest=expected_source_digest,
   312	        instrumentation_sha256=script_sha,
   313	    )
   314	
   315	    has_checkpoint = (out / "state.json").exists() or (out / "state.npy").exists()
   316	    if has_checkpoint:
   317	        validate_resume(out, prepared, runner, expected_source_digest, script_sha)
   318	    elif out.exists() and any(out.iterdir()):
   319	        raise ValueError("fresh collision directory must be empty")
   320	
   321	    result = runner.run(out, max_steps=max_steps)
   322	    atomic_json(
   323	        out / "r3m14_witness_run_receipt.json",
   324	        {
   325	            "schema": "BASS_CR_R3M14_WITNESS_RUN_RECEIPT_V2",
   326	            "status": result.get("status"),
   327	            "done": result.get("done", result.get("nstep")),
   328	            "nstep": result.get("nstep"),
   329	            "source_digest": source_digest(),
   330	            "r3m13_helper_sha256": prepared["helper_sha256"],
   331	            "instrumentation_sha256": script_sha,
   332	            "runtime_environment": runtime_environment(runner.backend),
   333	            "initial_binding_status": load_json(
   334	                out / "r3m14_initial_binding.json"
   335	            )["status"],
   336	            "state_json_sha256": (
   337	                file_sha(out / "state.json") if (out / "state.json").is_file() else None
   338	            ),
   339	            "state_npy_sha256": (
   340	                file_sha(out / "state.npy") if (out / "state.npy").is_file() else None
   341	            ),
   342	            "seal_sha256": (
   343	                file_sha(out / "r3m11_checkpoint_seal.json")
   344	                if (out / "r3m11_checkpoint_seal.json").is_file()
   345	                else None
   346	            ),
   347	            "physical_rate_evaluated": False,
   348	            "bgrid": "NO_GO",
   349	        },
   350	    )
   351	    return result
   352	
   353	
   354	def main():
   355	    parser = argparse.ArgumentParser(description=__doc__)
   356	    parser.add_argument("--config", required=True)
   357	    parser.add_argument("--prepared", required=True)
   358	    parser.add_argument("--out", required=True)
   359	    parser.add_argument("--max-steps", type=int)
   360	    args = parser.parse_args()
   361	    result = run_bound(
   362	        Path(args.config),
   363	        Path(args.prepared),
   364	        Path(args.out),
   365	        args.max_steps,
   366	    )
   367	    print(json.dumps(result, indent=2, allow_nan=False))
   368	
   369	
   370	if __name__ == "__main__":
   371	    main()
     1	"""Preserve sealed chunk boundaries without changing the frozen numerical runner.
     2	
     3	Call snapshot ONLY after the v2 witness CLI has returned successfully, and await
     4	it before starting the next chunk. No writer may run concurrently. The frozen
     5	``atomic_npy`` uses os.replace; hardlinks therefore retain the old state inode
     6	when a later save replaces state.npy. In-place writes to either hardlink are NOT
     7	supported. This is an application-level create-only protocol, not filesystem
     8	write protection or a claim of protection against arbitrary storage failure.
     9	
    10	Each generation eventually retains another full state inode. A 63,000,000-point
    11	complex128 state is about 1,008,000,128 bytes: 29 retained generations cost about
    12	29.232 GB (about 27.23 GiB), PLUS current/temporary state, initial/final arrays and
    13	other artifacts. A successful hardlink itself needs little space; it is NOT a
    14	promise of negligible retained storage. Budget disk before the collision. No
    15	pruning, cross-filesystem copy fallback, or restore over an old run is performed.
    16	
    17	An exclusive output directory is reserved first; the manifest/restore receipt
    18	is published last. Interrupted output, including .pending files, is preserved.
    19	Only a fully verified manifest authorizes restore, and restore always creates a
    20	fresh directory. Run files, witness, and hashes are verified without allocating
    21	a GPU runner or reading an entire state into RAM. Local restart verification
    22	does not imply remote backup or remote restore verification.
    23	"""
    24	from __future__ import annotations
    25	
    26	import argparse
    27	import errno
    28	import json
    29	import math
    30	import os
    31	from pathlib import Path
    32	import re
    33	import shutil
    34	import stat
    35	
    36	import numpy as np
    37	
    38	from cr_repro.grid import GridSpec
    39	from cr_repro.observables import projectile_speed_au
    40	from cr_repro.r3m11 import file_sha, source_digest
    41	from cr_repro.util import config_hash
    42	from scripts.r3m14_collision_initial_witness import (
    43	    EXPECTED_SOURCE_DIGEST,
    44	    ROOT,
    45	    SCHEMA as WITNESS_SCHEMA,
    46	    load_json,
    47	)
    48	
    49	SCHEMA = "BASS_CR_R3M17_CHECKPOINT_GENERATION_V1"
    50	MANIFEST_NAME = "r3m17_generation_manifest.json"
    51	RESTORE_RECEIPT = "r3m17_restore_receipt.json"
    52	SEAL = "r3m11_checkpoint_seal.json"
    53	WITNESS = "r3m14_initial_binding.json"
    54	RECEIPT = "r3m14_witness_run_receipt.json"
    55	REQUIRED = ("state.npy", "state.json", SEAL)
    56	OPTIONAL = (WITNESS, RECEIPT, "result.json")
    57	
    58	
    59	def _safe_path(path: Path) -> Path:
    60	    """Reject symlinks including parent components; never resolve through one."""
    61	    path = Path(os.path.abspath(path))
    62	    for part in reversed((path, *path.parents)):
    63	        if part.is_symlink():
    64	            raise ValueError(f"symlink path is forbidden: {part}")
    65	    return path
    66	
    67	
    68	def _regular(path: Path) -> None:
    69	    _safe_path(path)
    70	    try:
    71	        mode = path.lstat().st_mode
    72	    except FileNotFoundError as exc:
    73	        raise ValueError(f"missing required regular file: {path.name}") from exc
    74	    if not stat.S_ISREG(mode):
    75	        raise ValueError(f"not a regular file: {path}")
    76	
    77	
    78	def _integer(value, name: str) -> int:
    79	    if type(value) is not int:
    80	        raise ValueError(f"{name} must be an integer")
    81	    return value
    82	
    83	
    84	def _fsync_directory(path: Path) -> None:
    85	    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    86	    try:
    87	        os.fsync(fd)
    88	    finally:
    89	        os.close(fd)
    90	
    91	
    92	def _publish_json(path: Path, value: dict) -> None:
    93	    """Publish complete bytes without ever replacing existing evidence."""
    94	    pending = path.with_name(path.name + ".pending")
    95	    payload = json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + "\n"
    96	    with pending.open("x") as stream:
    97	        stream.write(payload)
    98	        stream.flush()
    99	        os.fsync(stream.fileno())
   100	    os.link(pending, path, follow_symlinks=False)
   101	    _fsync_directory(path.parent)
   102	    pending.unlink()
   103	    _fsync_directory(path.parent)
   104	
   105	
   106	def _copy_exclusive(source: Path, target: Path) -> None:
   107	    _regular(source)
   108	    with source.open("rb") as src, target.open("xb") as dst:
   109	        shutil.copyfileobj(src, dst, length=1024 * 1024)
   110	        dst.flush()
   111	        os.fsync(dst.fileno())
   112	
   113	
   114	def _link_state(source: Path, target: Path) -> None:
   115	    _regular(source)
   116	    if source.stat().st_dev != target.parent.stat().st_dev:
   117	        raise OSError(errno.EXDEV, "state hardlink requires the same filesystem; no copy fallback")
   118	    try:
   119	        os.link(source, target, follow_symlinks=False)
   120	    except OSError as exc:
   121	        if exc.errno == errno.EXDEV:
   122	            raise OSError(errno.EXDEV, "state hardlink requires the same filesystem; no copy fallback") from exc
   123	        raise
   124	    # The writer already fsyncs state bytes before atomic replacement. Retain
   125	    # that durability boundary without modifying the shared inode or mode.
   126	    with target.open("rb") as stream:
   127	        os.fsync(stream.fileno())
   128	
   129	
   130	def _enriched_config(raw_cfg: dict) -> dict:
   131	    cfg = dict(raw_cfg)
   132	    cfg["_r3m11_controls"] = "FIXED_CAP_SYMMETRIC_V1"
   133	    cfg["_r3m11_source_digest"] = EXPECTED_SOURCE_DIGEST
   134	    return cfg
   135	
   136	
   137	def validate_checkpoint(run_dir: Path, raw_cfg: dict, *, require_witness: bool = True) -> dict:
   138	    """Validate sealed bytes, source/config, step count and optional v2 evidence.
   139	
   140	    This intentionally does not instantiate ControlledTDLRunner: an inspection
   141	    must not allocate the production FFT arrays or change the GPU environment.
   142	    Existing witness runtime identity is preserved; the original v2 CLI checks
   143	    it against the actual scientific runtime and preparation again on restart.
   144	    """
   145	    root = _safe_path(run_dir)
   146	    if source_digest() != EXPECTED_SOURCE_DIGEST:
   147	        raise ValueError("frozen numerical source digest mismatch")
   148	    for name in REQUIRED:
   149	        _regular(root / name)
   150	    seal = load_json(root / SEAL)
   151	    if seal.get("schema") != "R3M11_CHECKPOINT_SEAL_V1":
   152	        raise ValueError("invalid checkpoint seal schema")
   153	    if seal.get("source_digest") != EXPECTED_SOURCE_DIGEST:
   154	        raise ValueError("checkpoint seal source mismatch")
   155	    hashes = {name: file_sha(root / name) for name in REQUIRED}
   156	    if seal.get("files") != {name: hashes[name] for name in ("state.json", "state.npy")}:
   157	        raise ValueError("checkpoint hash mismatch")
   158	    meta = load_json(root / "state.json")
   159	    ident = config_hash(_enriched_config(raw_cfg))
   160	    if meta.get("config_hash") != ident:
   161	        raise ValueError("checkpoint config mismatch")
   162	    done = _integer(meta.get("done"), "done")
   163	    nstep = _integer(meta.get("nstep"), "nstep")
   164	    v = projectile_speed_au(raw_cfg["energy_keV_per_u"])
   165	    total_time = (float(raw_cfg.get("z_stop", 60.)) - float(raw_cfg.get("z_start", -30.))) / v
   166	    dt = float(raw_cfg["dt"])
   167	    if not math.isfinite(total_time) or total_time <= 0 or not math.isfinite(dt) or dt <= 0:
   168	        raise ValueError("invalid configured horizon or dt")
   169	    expected_nstep = math.ceil(total_time / dt)
   170	    if nstep != expected_nstep or not 0 <= done <= nstep:
   171	        raise ValueError("invalid checkpoint done/nstep")
   172	    if meta.get("backend") != raw_cfg.get("backend", "numpy"):
   173	        raise ValueError("checkpoint backend mismatch")
   174	    norm = meta.get("norm")
   175	    if isinstance(norm, bool) or not isinstance(norm, (int, float)) or not math.isfinite(norm) or norm <= 0:
   176	        raise ValueError("invalid checkpoint norm")
   177	    array = np.load(root / "state.npy", mmap_mode="r", allow_pickle=False)
   178	    if array.shape != GridSpec.from_dict(raw_cfg["grid"]).shape() or array.dtype != np.dtype("complex128"):
   179	        raise ValueError("checkpoint state shape/dtype mismatch")
   180	    del array
   181	    present = []
   182	    for name in OPTIONAL:
   183	        if os.path.lexists(root / name):
   184	            _regular(root / name)
   185	            hashes[name] = file_sha(root / name)
   186	            present.append(name)
   187	    if require_witness and (WITNESS not in present or RECEIPT not in present):
   188	        raise ValueError("production checkpoint requires v2 witness and completed-chunk receipt")
   189	    if (WITNESS in present) != (RECEIPT in present):
   190	        raise ValueError("partial witness/receipt pair; wait for successful v2 CLI return")
   191	    if WITNESS in present:
   192	        witness = load_json(root / WITNESS)
   193	        for key in ("prepared_array_digest", "internal_array_digest",
   194	                    "prepared_state_file_sha256", "prepared_receipt_sha256"):
   195	            value = witness.get(key)
   196	            if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
   197	                raise ValueError(f"v2 witness invalid digest: {key}")
   198	        runtime = witness.get("runtime_environment")
   199	        prepared_environment = witness.get("prepared_environment")
   200	        for name, environment in (("runtime", runtime), ("prepared", prepared_environment)):
   201	            if not isinstance(environment, dict):
   202	                raise ValueError(f"v2 witness missing {name} environment")
   203	            for key in ("python", "numpy", "backend"):
   204	                value = environment.get(key)
   205	                if not isinstance(value, str) or not value.strip():
   206	                    raise ValueError(f"v2 witness invalid {name} environment: {key}")
   207	            if environment["backend"] != meta["backend"]:
   208	                raise ValueError(f"v2 witness {name} environment backend mismatch")
   209	        if any(runtime[key] != prepared_environment[key] for key in ("python", "numpy", "backend")):
   210	            raise ValueError("v2 witness prepared/runtime environment mismatch")
   211	        checks = {
   212	            "schema": WITNESS_SCHEMA,
   213	            "status": "PASS_BYTE_IDENTICAL_INTERNAL_INITIAL_TO_PREPARED",
   214	            "expected_source_digest": EXPECTED_SOURCE_DIGEST,
   215	            "actual_source_digest": EXPECTED_SOURCE_DIGEST,
   216	            "enriched_config_hash": ident,
   217	            "instrumentation_sha256": file_sha(ROOT / "scripts/r3m14_collision_initial_witness.py"),
   218	            "r3m13_helper_sha256": file_sha(ROOT / "scripts/r3m13_initial_state_pair.py"),
   219	            "array_digest_match": True,
   220	            "environment_match": True,
   221	            "norm_match": True,
   222	            "numerical_state_substituted": False,
   223	            "numerical_state_renormalized": False,
   224	            "backend": meta["backend"],
   225	            "shape": list(GridSpec.from_dict(raw_cfg["grid"]).shape()),
   226	            "dtype": np.dtype("complex128").str,
   227	            "dv": GridSpec.from_dict(raw_cfg["grid"]).dv,
   228	        }
   229	        for key, value in checks.items():
   230	            if (witness.get(key) != value
   231	                    or (type(value) is bool and witness.get(key) is not value)):
   232	                raise ValueError(f"v2 witness mismatch: {key}")
   233	        if witness.get("prepared_array_digest") != witness.get("internal_array_digest"):
   234	            raise ValueError("v2 witness array digest mismatch")
   235	        receipt = load_json(root / RECEIPT)
   236	        _integer(receipt.get("done"), "receipt done")
   237	        _integer(receipt.get("nstep"), "receipt nstep")
   238	        checks = {
   239	            "schema": "BASS_CR_R3M14_WITNESS_RUN_RECEIPT_V2",
   240	            "status": "completed" if done == nstep else "checkpoint",

