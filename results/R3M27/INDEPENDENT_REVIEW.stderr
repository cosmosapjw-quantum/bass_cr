   125	def _row(name, row, quantity, profile, allocation=None):
   126	    if row is None:
   127	        return dict(status="MISSING", admitted=False, absolute_error=None,
   128	                    evidence_class=None, evidence_refs=[], reasons=["MISSING_COMPONENT"]), None
   129	    if not isinstance(row, dict):
   130	        raise ValueError(f"{name} must be a component object")
   131	    if _quantity(row.get("quantity"), profile) != quantity:
   132	        raise ValueError(f"{name} quantity identity mismatch")
   133	    absolute = row.get("absolute_error")
   134	    error = None if absolute is None else _number(absolute, f"{name}.absolute_error")
   135	    reasons = []
   136	    evidence_class = row.get("evidence_class")
   137	    if not isinstance(evidence_class, str) or evidence_class not in ADMITTED_CLASSES:
   138	        reasons.append("EVIDENCE_CLASS_NOT_ADMISSIBLE")
   139	    if error is None:
   140	        reasons.append("MISSING_ERROR_ESTIMATE")
   141	    if not _refs(row.get("evidence_refs")):
   142	        reasons.append("MISSING_EVIDENCE_REFERENCES")
   143	    if row.get("support_scope") != "FULL_COMPONENT_FOR_DECLARED_QUANTITY":
   144	        reasons.append("LOCAL_OR_UNDECLARED_SUPPORT_SCOPE")
   145	    if evidence_class == "VALIDATED_ESTIMATE":
   146	        validation = row.get("validation")
   147	        for key in ("preregistered", "held_out_checked", "conservative_envelope_checked"):
   148	            if not isinstance(validation, dict) or validation.get(key) is not True:
   149	                reasons.append(f"VALIDATED_ESTIMATE_REQUIRES_{key.upper()}")
   150	    if evidence_class == "CERTIFIED_BOUND":
   151	        certification = row.get("certification")
   152	        for key in ("proof_checked", "roundoff_controlled"):
   153	            if not isinstance(certification, dict) or certification.get(key) is not True:
   154	                reasons.append(f"CERTIFICATION_REQUIRES_{key.upper()}")
   155	    limit = None if allocation is None else allocation * quantity["reference_value"]
   156	    exceeds = None if error is None or limit is None else error > limit
   157	    admitted = not reasons
   158	    return dict(status="ADMITTED_WITHIN_ALLOCATION" if admitted and not exceeds else
   159	                       "ADMITTED_EXCEEDS_ALLOCATION" if admitted else "UNADMITTED",
   160	                admitted=admitted, absolute_error=None if error is None else _display(error),
   161	                absolute_error_exact=None if error is None else _exact(error),
   162	                evidence_class=evidence_class, evidence_refs=row.get("evidence_refs", []),
   163	                allocation_relative=None if allocation is None else _display(allocation),
   164	                allocation_absolute=None if limit is None else _display(limit),
   165	                reported_value_exceeds_allocation=exceeds,
   166	                reasons=reasons), error
