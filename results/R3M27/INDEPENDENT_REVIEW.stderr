   134	
   135	def command_plan(config: Path, root: Path) -> list[dict]:
   136	    prepared, collision = root / 'preparation', root / 'collision'
   137	    commands = [
   138	        dict(phase='resource', argv=[SCIENCE, str(ROOT/'scripts/r3m15_resource_probe.py'),
   139	                                     '--config', str(config), '--out', str(root/'resource.json')]),
   140	        dict(phase='prepare', argv=[SCIENCE, str(ROOT/'scripts/r3m13_initial_state_pair.py'),
   141	                                    'prepare', '--config', str(config), '--out', str(prepared)]),
   142	    ]
   143	    for chunk in range(1, CHUNKS + 1):
   144	        done = min(chunk * CHUNK, NSTEP)
   145	        steps = done - (chunk - 1) * CHUNK
   146	        commands.append(dict(phase='collision', chunk=chunk, done=done, steps=steps,
   147	            argv=[SCIENCE, str(ROOT/'scripts/r3m14_collision_initial_witness.py'),
   148	                  '--config', str(config), '--prepared', str(prepared),
   149	                  '--out', str(collision), '--max-steps', str(CHUNK)]))
   150	        commands.append(dict(phase='snapshot', chunk=chunk, done=done,
   151	            argv=[SCIENCE, str(ROOT/'scripts/r3m17_checkpoint_guard.py'), 'snapshot',
   152	                  '--run', str(collision), '--out', str(root/'generations'/f'g{done:06d}'),
   153	                  '--config', str(config)]))
   154	    return commands
   155	
   156	
   157	def build_plan(config: Path, root: Path) -> dict:
   158	    config, root = Path(config).absolute(), Path(root).absolute()
   159	    if config != CONFIG or not root.is_absolute() or root == ROOT or ROOT in root.parents:
   160	        raise ValueError('canonical B3 config and external output root required')
   161	    cfg = read(config)
   162	    validate_b3_config(cfg)
   163	    if sha(FORECAST_PATH) != FORECAST or sha(B2_RESULT_PATH) != B2_RESULT:
   164	        raise ValueError('frozen forecast or B2 raw result bytes changed')
   165	    frozen = read(FORECAST_PATH)
   166	    payload = json.dumps(frozen['payload'], sort_keys=True, separators=(',', ':'), allow_nan=False)
   167	    if frozen.get('payload_sha256') != FORECAST_PAYLOAD or hashlib.sha256(payload.encode()).hexdigest() != FORECAST_PAYLOAD:
   168	        raise ValueError('frozen forecast payload changed')
   169	    head = git('rev-parse', 'HEAD')
   170	    if git('merge-base', PARENT, head) != PARENT or head == PARENT:
   171	        raise ValueError('B3 coordinator must be committed on descendant branch')
   172	    n = numerical_metadata(cfg)
   173	    return dict(schema='BASS_CR_R3M27_B3_CONTRACT_V1', canonical_node=
   174	        'N1_TDL_PRODUCTION_H_B3_FULL_COLLISION_CONTRACT_AND_TIME_REFINEMENT',
   175	        experiment_id='R3M27_B3_100KEVU_B2_H020_DT000625_20260924',
   176	        hypothesis='One held-out B3 point tests fixed-h selected-span temporal envelope.',
   177	        model_id='NONRELATIVISTIC_ONE_ELECTRON_FIXED_TARGET_STRAIGHT_LINE_POINT_COULOMB_V1',
   178	        source_commit=head, parent_commit=PARENT, source_digest=SOURCE,
   179	        source_hashes={name: sha(ROOT/name) for name in SOURCE_PATHS},
   180	        config=cfg, config_path=str(config), config_sha256=sha(config),
   181	        changed_parameter='requested real dt only: .025/.0125 family to .00625',
   182	        numerical=n, initial_reference_sha256=INITIAL,
   183	        b2_result_sha256=B2_RESULT, forecast_sha256=FORECAST,
   184	        forecast_payload_sha256=FORECAST_PAYLOAD,
   185	        runtime=runtime_identity(), output_root=str(root),
   186	        commands=command_plan(config, root),
   187	        observable=dict(id='Gram P_span_by_nmax cumulative n<=1/2/3',
   188	                        scope='100 keV/u b=2 fixed-h selected finite spans', units='probability'),
   189	        acceptance=dict(pair_relative=.001, empirical_time_relative=.001,
   190	                        forecast_immutable=True, production_admission=False),
   191	        resources=dict(gpu_jobs=1, gpu_reserve_bytes=GPU_RESERVE,
   192	                       host_reserve_bytes=HOST_RESERVE, state_bytes=STATE_BYTES,
   193	                       generation_count=CHUNKS,
   194	                       generations_bytes=STATE_BYTES*CHUNKS,
   195	                       disk_required_free_bytes=DISK_REQUIRED,
   196	                       disk_remaining_floor_bytes=DISK_REMAIN,
   197	                       total_seconds_cap=TOTAL_SECONDS,
   198	                       command_seconds_cap=COMMAND_SECONDS,
   199	                       cpu_workers=1, retained_generations=CHUNKS),
   200	        retry_policy='NO_AUTOMATIC_RETRY; explicit resume only after verified frontier',
   201	        new_full_collision_limit=1,
   202	        failure_branch='Preserve first failure and frontier; do not reinterpret resource stop as numerical failure.',
   203	        production_admission=False)
   204	
   205	
   206	def validate_plan(plan: dict, config: Path, root: Path) -> None:
   207	    expected = build_plan(config, root)
   208	    if json.dumps(plan, sort_keys=True, allow_nan=False) != json.dumps(expected, sort_keys=True, allow_nan=False):
   209	        raise ValueError('B3 exact contract/config/argv/source/runtime mismatch')
   210	
   211	
   212	def frontier_action(chunk: int, done: int, expected: int, has_generation: bool) -> str:
   213	    if type(chunk) is not int or not 1 <= chunk <= CHUNKS or type(done) is not int:
   214	        raise ValueError('invalid chunk/done type or range')
   215	    if expected != min(chunk*CHUNK, NSTEP):
   216	        raise ValueError('expected B3 frontier mismatch')
   217	    if has_generation:
   218	        return 'SKIP_VERIFIED_GENERATION'
   219	    before = (chunk-1)*CHUNK
   220	    if done == before:
   221	        return 'RUN_CHUNK'
   222	    if done == expected:
   223	        return 'PUBLISH_ONLY'
   224	    raise ValueError('active checkpoint outside frozen B3 frontier')
   225	
   226	
   227	def validate_generation(generation: Path, cfg: dict, expected_done: int) -> dict:
   228	    manifest = read(generation/guard.MANIFEST_NAME)
   229	    if manifest.get('schema') != guard.SCHEMA or manifest.get('status') != 'PUBLISHED_VERIFIED_LOCAL':
   230	        raise ValueError('generation is not published')
   231	    inventory = guard.validate_checkpoint(generation, cfg)
   232	    if any(manifest.get(key) != value for key, value in inventory.items()):
   233	        raise ValueError('generation manifest/inventory mismatch')
   234	    if inventory['done'] != expected_done or inventory['nstep'] != NSTEP:
   235	        raise ValueError('generation frontier differs from B3 contract')
   236	    return manifest
   237	
   238	
   239	def _host_available() -> int:
   240	    for line in Path('/proc/meminfo').read_text().splitlines():
   241	        if line.startswith('MemAvailable:'):
   242	            return int(line.split()[1])*1024
   243	    raise ValueError('MemAvailable unavailable')
   244	
   245	
   246	def _gpu_free() -> int:
   247	    output = subprocess.check_output(['nvidia-smi', '--query-gpu=memory.free',
   248	                                      '--format=csv,noheader,nounits'], text=True, timeout=15)
   249	    return int(output.splitlines()[0].strip())*1024**2
   250	
   251	
   252	def resources(root: Path) -> dict:
   253	    disk = shutil.disk_usage(root.parent)
   254	    value = dict(disk_free_bytes=disk.free, gpu_free_bytes=_gpu_free(),
   255	                 host_available_bytes=_host_available(),
   256	                 gpu_free_semantics='NVIDIA_SMI_SAMPLED_MIB',
   257	                 disk_required_free_bytes=DISK_REQUIRED,
   258	                 disk_remaining_floor_bytes=DISK_REMAIN)
   259	    if (disk.free < DISK_REQUIRED + DISK_REMAIN or
   260	            value['gpu_free_bytes'] < GPU_RESERVE or
   261	            value['host_available_bytes'] < HOST_RESERVE):
   262	        raise MemoryError(f'B3 resource preflight failed: {value}')
   263	    return value
   264	
   265	
   266	def _command(label: str, spec: dict, root: Path, started: float) -> dict:
   267	    phase = spec['phase']
   268	    cap = COMMAND_SECONDS[phase]
   269	    argv = spec['argv']
   270	    minimum = {'gpu': _gpu_free(), 'host': _host_available(), 'disk': shutil.disk_usage(root).free}
   271	    stop = None
   272	    begin = time.monotonic()
   273	    begin_wall = time.time()
   274	    witness_path = root/'collision'/'r3m14_initial_binding.json'
   275	    first_witness = phase == 'collision' and not witness_path.exists()
   276	    try:
   277	        import mlflow
   278	    except ImportError:
   279	        mlflow = None
   280	    trace = mlflow.start_span(name=label) if mlflow else contextlib.nullcontext(None)
   281	    with trace as span:
   282	        if span:
   283	            span.set_inputs(dict(argv=argv, cwd=str(ROOT), contract_phase=phase))
   284	        with (root/(label+'.stdout')).open('x') as stdout, (root/(label+'.stderr')).open('x') as stderr:
   285	            process = subprocess.Popen(argv, cwd=ROOT, env=_science_env(),
   286	                                       stdout=stdout, stderr=stderr, start_new_session=True)
   287	            while process.poll() is None:
   288	                try:
   289	                    minimum['gpu'] = min(minimum['gpu'], _gpu_free())
   290	                    minimum['host'] = min(minimum['host'], _host_available())
   291	                    minimum['disk'] = min(minimum['disk'], shutil.disk_usage(root).free)
   292	                    if minimum['gpu'] < GPU_RESERVE or minimum['host'] < HOST_RESERVE or minimum['disk'] < DISK_REMAIN:
   293	                        stop = 'RESOURCE_RESERVE_BREACH'
   294	                except BaseException as exc:
   295	                    stop = 'RESOURCE_MONITOR_FAILED:' + repr(exc)
   296	                if time.monotonic()-begin > cap or time.monotonic()-started > TOTAL_SECONDS:
   297	                    stop = 'COMMAND_OR_TOTAL_DEADLINE'
   298	                if stop:
   299	                    os.killpg(process.pid, signal.SIGTERM)
   300	                    try:
   301	                        process.wait(timeout=15)
   302	                    except subprocess.TimeoutExpired:
   303	                        os.killpg(process.pid, signal.SIGKILL)
   304	                        process.wait()
   305	                    break
   306	                time.sleep(2)
   307	            code = process.wait()
   308	        row = dict(label=label, phase=phase, argv=argv, exit_code=code,
   309	                   wall_seconds=time.monotonic()-begin, stop_reason=stop,
   310	                   minimum_sampled_gpu_free_bytes=minimum['gpu'],
   311	                   minimum_sampled_host_available_bytes=minimum['host'],
   312	                   minimum_sampled_disk_free_bytes=minimum['disk'],
   313	                   stdout_sha256=sha(root/(label+'.stdout')),
   314	                   stderr_sha256=sha(root/(label+'.stderr')),
   315	                   trace_id=span.trace_id if span else None)
   316	        if first_witness and witness_path.exists():
   317	            row['internal_initial_witness_elapsed_seconds_including_setup'] = max(
   318	                0.0, witness_path.stat().st_mtime - begin_wall)
   319	            row['internal_preparation_work'] = dict(imag_steps=4800,
   320	                imag_dt_au=.00625,
   321	                wall_semantics='WITNESS_FILE_BOUNDARY_INCLUDES_RUNNER_SETUP_HASH_AND_PREPARATION')
   322	        if span:
   323	            span.set_outputs(row)
   324	    if mlflow:
   325	        mlflow.flush_trace_async_logging()
   326	    publish(root/'receipts'/(label+'.json'), row)
   327	    if code or stop:
   328	        raise RuntimeError(f'{label}: exit={code}; stop={stop}')
   329	    return row
   330	
   331	
   332	def _prepared(root: Path, cfg: dict) -> dict:
   333	    from scripts.r3m14_collision_initial_witness import validate_prepared
   334	    value = validate_prepared(root/'preparation', cfg, SOURCE)
   335	    if value['state_file_sha256'] != INITIAL or value['receipt']['config'] != cfg:
   336	        raise ValueError('B3 fresh preparation differs from canonical B initial/config')
   337	    return value
   338	
   339	
   340	def execute(contract: Path, approval: str, *, explicit_resume: bool = False) -> dict:
   341	    contract = Path(contract).absolute()
   342	    if sha(contract) != approval:
   343	        raise ValueError('explicit B3 contract SHA approval mismatch')
   344	    plan = read(contract)
   345	    root, config = Path(plan['output_root']), Path(plan['config_path'])
   346	    validate_plan(plan, config, root)
   347	    if root.exists() and not explicit_resume:
   348	        raise FileExistsError('fresh B3 output required; explicit frontier-checked resume only')
   349	    if not root.exists():
   350	        root.mkdir(parents=True, exist_ok=False)
   351	        publish(root/'RUN.json', dict(contract_sha256=approval,
   352	            source_commit=plan['source_commit'], new_full_collision_limit=1,
   353	            automatic_retry=False, production_admission=False))
   354	    elif read(root/'RUN.json')['contract_sha256'] != approval:
   355	        raise ValueError('resume contract SHA mismatch')
   356	    (root/'receipts').mkdir(exist_ok=True)
   357	    (root/'generations').mkdir(exist_ok=True)
   358	    try:
   359	        import mlflow
   360	    except ImportError:
   361	        pass  # Numerical execution and durable receipts do not depend on tracing.
   362	    else:
   363	        os.environ.setdefault('MLFLOW_DISABLE_AGENT_HINT', '1')
   364	        if not (os.environ.get('MLFLOW_TRACKING_URI') and os.environ.get('MLFLOW_EXPERIMENT_ID')):
   365	            mlflow.set_tracking_uri('sqlite:///' + str(root/'mlflow.db'))
   366	            mlflow.set_experiment('R3M27_B3_FULL_COLLISION')
   367	    started = time.monotonic()
   368	    stage = 'RESOURCE_PREFLIGHT'
   369	    with (root/'gpu.lock').open('a+') as lock:
   370	        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
   371	        try:
   372	            if (root/'COMPLETE.json').exists():
   373	                raise FileExistsError('completed B3 must not rerun')
   374	            if not (root/'RESOURCE_INVENTORY.json').exists():
   375	                publish(root/'RESOURCE_INVENTORY.json', resources(root))
   376	            else:
   377	                resources(root)
   378	            if not (root/'resource.json').exists():
   379	                _command('resource_preflight', plan['commands'][0], root, started)
   380	            if not (root/'receipts/resource_preflight.json').is_file():
   381	                raise ValueError('resource output without completed command receipt')
   382	            if read(root/'resource.json').get('status') != 'PASS_RESOURCE_PREFLIGHT':
   383	                raise ValueError('FFT resource preflight did not pass')
   384	            stage = 'PREPARATION'
   385	            if not (root/'preparation').exists():
   386	                _command('prepare', plan['commands'][1], root, started)
   387	            if not (root/'receipts/prepare.json').is_file():
   388	                raise ValueError('preparation output without completed command receipt')
   389	            prepared = _prepared(root, plan['config'])
   390	            if not (root/'PREPARATION_BINDING.json').exists():
   391	                publish(root/'PREPARATION_BINDING.json', dict(
   392	                    status='PASS_EXACT_B3_CONFIG_AND_CANONICAL_INITIAL',
   393	                    receipt_sha256=prepared['receipt_sha256'],
   394	                    initial_sha256=prepared['state_file_sha256'],
   395	                    seconds=prepared['receipt']['seconds'],
   396	                    internal_preparation_expected_once_on_first_collision_chunk=True))
   397	            commands = plan['commands'][2:]
   398	            for i in range(CHUNKS):
   399	                collision, snapshot = commands[2*i:2*i+2]
   400	                chunk, expected = i+1, snapshot['done']
   401	                stage = f'COLLISION_CHUNK_{chunk:03d}'
   402	                if source_digest() != SOURCE:
   403	                    raise ValueError('frozen numerical source changed before chunk')
   404	                generation = root/'generations'/f'g{expected:06d}'
   405	                if generation.exists():
   406	                    validate_generation(generation, plan['config'], expected)
   407	                    continue
   408	                active = root/'collision'
   409	                done = guard.validate_checkpoint(active, plan['config'])['done'] if (active/'state.json').exists() else 0
   410	                action = frontier_action(chunk, done, expected, False)
   411	                if action == 'RUN_CHUNK':
   412	                    _command(f'collision.chunk{chunk:03d}', collision, root, started)
   413	                    inventory = guard.validate_checkpoint(active, plan['config'])
   414	                    if inventory['done'] != expected:
   415	                        raise ValueError('writer returned without exact B3 frontier')
   416	                stage = f'SNAPSHOT_CHUNK_{chunk:03d}'
   417	                _command(f'snapshot.g{expected:06d}', snapshot, root, started)
   418	                manifest = validate_generation(generation, plan['config'], expected)
   419	                publish(root/'receipts'/f'chunk{chunk:03d}.committed.json', dict(
   420	                    status='CHUNK_AND_GENERATION_COMMITTED', chunk=chunk, done=expected,
   421	                    generation_manifest_sha256=sha(generation/guard.MANIFEST_NAME),
   422	                    state_sha256=manifest['files']['state.npy']['sha256'],
   423	                    next_chunk_authorized=chunk<CHUNKS))
   424	            stage = 'FINAL_AUDIT'
   425	            final = guard.validate_checkpoint(root/'collision', plan['config'])
   426	            result = read(root/'collision/result.json')
   427	            if final['done'] != NSTEP or result.get('status') != 'completed':
   428	                raise ValueError('B3 final result/checkpoint incomplete')
   429	            complete = dict(status='COMPLETE', job='B3', chunks=CHUNKS,
   430	                retained_generations=CHUNKS, done=NSTEP, nstep=NSTEP,
   431	                contract_sha256=approval,
   432	                preparation_receipt_sha256=prepared['receipt_sha256'],
   433	                result_sha256=sha(root/'collision/result.json'),
   434	                final_generation_manifest_sha256=sha(root/'generations'/'g007172'/guard.MANIFEST_NAME),
   435	                new_full_collisions=1, production_admission=False)
   436	            publish(root/'COMPLETE.json', complete)
   437	            return complete
   438	        except BaseException as exc:
   439	            failure = root/'FIRST_FAILURE.json'
   440	            if not failure.exists():
   441	                try:
   442	                    publish(failure, dict(stage=stage, exception_type=type(exc).__name__,
   443	                        message=str(exc), traceback=traceback.format_exc(),
   444	                        automatic_retry=False, scientific_nonconvergence='UNDETERMINED',
   445	                        completed_generations=len(list((root/'generations').glob('g*/r3m17_generation_manifest.json'))),
   446	                        production_admission=False))
   447	                except BaseException:
   448	                    pass
   449	            raise
   450	
   451	
   452	def main(argv=None) -> None:
   453	    parser = argparse.ArgumentParser(description=__doc__)
   454	    sub = parser.add_subparsers(dest='command', required=True)
   455	    f = sub.add_parser('freeze')
   456	    f.add_argument('--config', type=Path, default=CONFIG)
   457	    f.add_argument('--root', type=Path, required=True)
   458	    f.add_argument('--contract', type=Path, required=True)
   459	    r = sub.add_parser('run')
   460	    r.add_argument('--contract', type=Path, required=True)
   461	    r.add_argument('--approve-sha256', required=True)
   462	    r.add_argument('--explicit-resume', action='store_true')
   463	    args = parser.parse_args(argv)
   464	    if args.command == 'freeze':
   465	        dirty = git('status', '--porcelain', '--', 'scripts/r3m27_b3_execute.py',
   466	                    'tests/test_r3m27_b3_execute.py', 'configs/r3m27/B3.json')
   467	        if dirty:
   468	            raise ValueError('commit B3 source/config/tests before freeze')
   469	        plan = build_plan(args.config, args.root)
   470	        if args.root.exists():
   471	            raise FileExistsError('fresh B3 output root required')
   472	        resources(args.root)
   473	        publish(args.contract, plan)
   474	        manifest = args.contract.with_name('HASH_MANIFEST.json')
   475	        publish(manifest, dict(contract_sha256=sha(args.contract),
   476	            config_sha256=plan['config_sha256'], forecast_sha256=FORECAST,
   477	            forecast_payload_sha256=FORECAST_PAYLOAD,
   478	            source_hashes=plan['source_hashes'], output_root=plan['output_root']))
   479	        print(json.dumps(dict(contract=str(args.contract), sha256=sha(args.contract),
   480	                              generations=CHUNKS, gpu_work=0)))
   481	    else:
   482	        print(json.dumps(execute(args.contract, args.approve_sha256,
   483	                                 explicit_resume=args.explicit_resume), sort_keys=True))
   484	
   485	
   486	if __name__ == '__main__':
   487	    main()

