   106	def _display_tree(value):
   107	    """JSON-safe display numbers; exact numeric identities are returned separately."""
   108	    if type(value) is Decimal:
   109	        return _display(Fraction(value))
   110	    if isinstance(value, dict):
   111	        return {key: _display_tree(item) for key, item in value.items()}
   112	    if isinstance(value, list):
   113	        return [_display_tree(item) for item in value]
   114	    return value
   115	
   116	
   117	def _identity_exact_tree(value):
