    49	def canonical(value):
    50	    return json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False)
    51	
    52	
    53	def payload_hash(value):
    54	    return hashlib.sha256(canonical(value).encode()).hexdigest()
    55	
    56	
    57	def write_new(path,value):
    58	    text=json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n'
    59	    path=Path(path); path.parent.mkdir(parents=True,exist_ok=True)
    60	    with path.open('x') as stream: stream.write(text)
    61	
    62	
    63	def number(x,name,*,positive=False):
    64	    if isinstance(x,(bool,np.bool_)) or not isinstance(x,(int,float,np.integer,np.floating)):
    65	        raise ValueError(f'{name}: actual number required, not Boolean/string')
    66	    x=float(x)
    67	    if not math.isfinite(x) or (positive and x<=0):
    68	        raise ValueError(f'{name}: finite'+(' positive' if positive else '')+' number required')
    69	    return x
    70	
    71	
    72	def _probabilities(values,count):
    73	    if len(values)!=count: raise ValueError(f'exactly {count} probabilities required')
    74	    vals=[number(v,'probability',positive=True) for v in values]
    75	    if any(v>1+2e-10 for v in vals): raise ValueError('probability exceeds one')
    76	    return vals
    77	
    78	
    79	def _steps(values,count):
    80	    if len(values)!=count: raise ValueError(f'exactly {count} actual timesteps required')
    81	    out=[number(v,'actual dt',positive=True) for v in values]
    82	    if any(a<=b for a,b in zip(out,out[1:])):raise ValueError('distinct decreasing actual dt required')
    83	    return out
    84	
    85	
    86	def _even_fit(values,dt,query=0.):
    87	    scale=max(dt); x=(np.asarray(dt,dtype=float)/scale)**2
    88	    matrix=np.column_stack((np.ones(len(x)),x,x*x))
    89	    offset=values[-1]; y=np.asarray(values)-offset
    90	    if len(values)==3: coefficient=np.linalg.solve(matrix,y)
    91	    else: coefficient,_,rank,_=np.linalg.lstsq(matrix,y,rcond=None)
    92	    if np.linalg.matrix_rank(matrix)!=3:raise ValueError('even model rank loss')
    93	    q=(query/scale)**2
    94	    return float(offset+np.array([1.,q,q*q])@coefficient)
