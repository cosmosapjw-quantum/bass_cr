   173	def _strict_result(raw,cfg):
   174	    if canonical(raw.get('config'))!=canonical(enriched(cfg)):
   175	        raise ValueError('typed exact config/source family mismatch')
   176	    for key in ('dt_actual','v_au','nstep'):number(raw.get(key),key,positive=True)
   177	    if type(raw['nstep']) is not int:raise ValueError('integer nstep required')
   178	    audit=raw['analysis']['gram_audit']
   179	    expected_qns=[list(q) for q in bound_quantum_numbers(cfg['project_nmax'])]
   180	    if canonical(audit.get('quantum_numbers'))!=canonical(expected_qns) or type(audit.get('project_nmax')) is not int:
   181	        raise ValueError('typed projector channel identity mismatch')
   182	    for key in ('Gram_condition','wavefunction_norm','P_region','P_span_nmax'):
   183	        number(audit[key],key,positive=key!='P_region')
   184	    for key in ('Gram_eigenvalues','finite_grid_state_norms'):
   185	        for val in audit[key]:number(val,key,positive=True)
   186	    _probabilities([audit['P_span_by_nmax'][str(i)] for i in (1,2,3)],3)
   187	    row=validate_result(raw,cfg)
   188	    if audit['P_span_nmax']!=row['P3']:
   189	        raise ValueError('selected-span readouts disagree')
   190	    if audit.get('physical_all_bound_admitted') is not False or audit.get('continuum_probability') is not None:
   191	        raise ValueError('finite-span observable semantics mismatch')
   192	    return row
