   134	def historical_baseline():
   135	    rows = {}
   136	    for cell, (path, digest, cfgpath) in PINS.items():
   137	        path = ROOT/path
   138	        if sha(path) != digest:
   139	            raise ValueError('historical result identity changed: ' + cell)
   140	        rows[cell] = validate_result(read_json(path), read_json(ROOT/cfgpath))
   141	        rows[cell]['result_sha256'] = digest
   142	    prep = read_json(ROOT/'results/R3M15/B/preparation/receipt.json')
   143	    pointer = read_json(ROOT/'results/R3M16/collisions/B1_MANIFEST.json')
   144	    if (prep['initial_state_sha256'] != INITIAL_SHA or
   145	            pointer['immutable_arrays'][0]['sha256'] != INITIAL_SHA or
   146	            pointer['binding_status'] != 'PASS_BYTE_IDENTICAL_INTERNAL_INITIAL_TO_PREPARED' or
   147	            pointer['seal_source_digest'] != SOURCE or
   148	            pointer['result']['sha256'] != PINS['B1'][1]):
   149	        raise ValueError('historical preparation identities disagree')
   150	    rows.update(initial_bytes_match=True, initial_state_sha256=INITIAL_SHA,
   151	                authority='Pinned R3M15 raw receipt and R3M16 repository pointer; no new raw remote readback')
   152	    return rows
   153	
   154	
   155	def temporal_triplet(values, steps, *, relative_tolerance=.001, absolute_tolerance=None):
   156	    if len(values) != 3 or len(steps) != 3:
   157	        raise ValueError('exactly three values and actual timesteps required')
   158	    if not all(math.isfinite(x) and 0 <= x <= 1+2e-10 for x in values):
   159	        raise ValueError('finite nonnegative probabilities required')
   160	    if not all(math.isfinite(x) and x > 0 for x in steps) or not steps[0] > steps[1] > steps[2]:
   161	        raise ValueError('strictly decreasing positive actual timesteps required')
   162	    if not math.isfinite(relative_tolerance) or relative_tolerance <= 0:
   163	        raise ValueError('positive finite relative tolerance required')
   164	    if absolute_tolerance is not None and (not math.isfinite(absolute_tolerance) or absolute_tolerance <= 0):
   165	        raise ValueError('positive explicit absolute tolerance required')
   166	    p0,p1,p2 = values
   167	    d01,d12 = p1-p0,p2-p1
   168	    relative = abs(d12)/abs(p2) if p2 != 0 else None
   169	    if p2 == 0:
   170	        screen = ('ABSOLUTE_TOLERANCE_REQUIRED' if absolute_tolerance is None else
   171	                  'PASS_ABSOLUTE_PAIR_ONLY' if abs(d12) <= absolute_tolerance else 'FAIL_ABSOLUTE_PAIR_SCREEN')
   172	    else:
   173	        screen = 'PASS_PAIR_ONLY' if relative <= relative_tolerance else 'FAIL_PAIR_SCREEN'
   174	    result = dict(status='UNRESOLVED_DIFFERENCES', values=list(values), actual_dt=list(steps),
   175	                  signed_coarse_change=d01, signed_fine_change=d12,
   176	                  fine_pair_absolute=abs(d12), fine_pair_relative=relative,
   177	                  relative_denominator=abs(p2), fine_pair_screen=screen,
   178	                  relative_tolerance=relative_tolerance, absolute_tolerance=absolute_tolerance,
   179	                  observed_order=None, extrapolated_value=None,
   180	                  conditional_fine_error_absolute=None, conditional_fine_error_relative=None,
   181	                  clean_second_order_consistency=False, budget_closed=False,
   182	                  certified_error_bound=None,
   183	                  empirical_model='P(dt)=P(0)+c*dt**p; three levels cannot validate their own remainder model')
   184	    if screen == 'ABSOLUTE_TOLERANCE_REQUIRED':
   185	        result['status'] = screen
   186	        return result
   187	    # Resolution test is a floating-point diagnostic, never an absolute scientific tolerance.
   188	    floor = 64*np.finfo(float).eps*max(abs(x) for x in values)
   189	    result['roundoff_resolution_floor'] = floor
   190	    if min(abs(d01), abs(d12)) <= floor:
   191	        return result
   192	    if d01*d12 < 0:
   193	        result['status'] = 'SIGN_CHANGE_NONASYMPTOTIC'
   194	        return result
   195	    if abs(d12) >= abs(d01):
   196	        result['status'] = 'NO_CONTRACTION'
   197	        return result
   198	    l01, l12 = math.log(steps[0]/steps[1]), math.log(steps[1]/steps[2])
   199	    ratio = d01/d12
   200	    def ratio_model(order):
   201	        return math.expm1(order*l01)/(-math.expm1(-order*l12))
   202	    if not ratio_model(1e-6) < ratio < ratio_model(12):
   203	        result['status'] = 'NO_RESOLVED_POSITIVE_ORDER_IN_REGISTERED_RANGE'
   204	        return result
   205	    order = brentq(lambda p: ratio_model(p)-ratio, 1e-6, 12, xtol=1e-12)
   206	    correction = d12/math.expm1(order*l12)
   207	    result.update(status='EMPIRICAL_CONTRACTION_ONLY', observed_order=order,
   208	                  extrapolated_value=p2+correction,
   209	                  conditional_fine_error_absolute=abs(correction),
   210	                  conditional_fine_error_relative=abs(correction)/abs(p2) if p2 else None,
   211	                  clean_second_order_consistency=1.5 <= order <= 2.5)
   212	    if (result['clean_second_order_consistency'] and screen == 'PASS_PAIR_ONLY' and
   213	            result['conditional_fine_error_relative'] <= relative_tolerance):
   214	        result['status'] = 'EMPIRICAL_TEMPORAL_CANDIDATE_REQUIRES_CROSSCHECK'
   215	    return result
   216	
   217	
   218	def analyze_b2(run, prepared):
   219	    """Read and hash local B2 evidence once; does not re-download remote arrays."""
   220	    from scripts.r3m14_collision_initial_witness import validate_prepared
   221	    from scripts.r3m17_checkpoint_guard import validate_checkpoint
   222	    if source_digest() != SOURCE:
   223	        raise ValueError('frozen numerical source changed')
   224	    run, prepared = Path(run), Path(prepared)
   225	    cfg = read_json(ROOT/'configs/r3m16/B1.json')
   226	    cfg['dt'] = .0125
   227	    raw = read_json(run/'result.json')
   228	    row = validate_result(raw, cfg)
   229	    prepared_info = validate_prepared(prepared, cfg, SOURCE)
   230	    if prepared_info['state_file_sha256'] != INITIAL_SHA:
   231	        raise ValueError('B2 preparation bytes differ from B0/B1')
   232	    witness = read_json(run/'r3m14_initial_binding.json')
   233	    validate_witness(witness, cfg)
   234	    if (witness['prepared_receipt_sha256'] != prepared_info['receipt_sha256'] or
   235	            witness['prepared_array_digest'] != prepared_info['array_digest']):
   236	        raise ValueError('witness does not bind supplied preparation')
   237	    checkpoint = validate_checkpoint(run, cfg, require_witness=True)
   238	    state = read_json(run/'state.json')
   239	    if (checkpoint['done'] != row['nstep'] or checkpoint['nstep'] != row['nstep']):
   240	        raise ValueError('B2 completed checkpoint identity mismatch')
   241	    if (state['initial'] != raw['initial'] or raw['initial'] != witness['initial_metadata'] or
   242	            not math.isclose(state['norm'], row['norm'], rel_tol=5e-10, abs_tol=0.0)):
   243	        raise ValueError('B2 result/checkpoint/initial witness metadata mismatch')
   244	    row['result_sha256'] = checkpoint['files']['result.json']['sha256']
   245	    baseline = historical_baseline()
   246	    rows = {key:baseline[key] for key in ('B0','B1')}
   247	    rows['B2'] = row
   248	    per_channel = {p: temporal_triplet([rows[k][p] for k in rows],
   249	                                     [rows[k]['actual_dt'] for k in rows]) for p in ('P1','P2','P3')}
   250	    candidate = all(v['status'] == 'EMPIRICAL_TEMPORAL_CANDIDATE_REQUIRES_CROSSCHECK' for v in per_channel.values())
   251	    return dict(schema='BASS_CR_R3M17_B_TEMPORAL_V1', rows=rows,
   252	                channel_temporal_analysis=per_channel,
   253	                decision='EMPIRICAL_TEMPORAL_CANDIDATE_REQUIRES_CROSSCHECK' if candidate else 'TIME_REFINEMENT_STILL_OPEN',
   254	                production_admitted=False, representation_change_admitted=False,
   255	                spatial_gap_at_dt0125=None, missing_spatial_cell='A2_NOT_RUN',
   256	                initial_state_sha256=INITIAL_SHA, numerical_source_digest=SOURCE,
   257	                instrumentation_sha256=sha(Path(__file__)),
   258	                evidence={'B2_witness_sha256':sha(run/'r3m14_initial_binding.json'),
   259	                          'B2_seal_sha256':sha(run/'r3m11_checkpoint_seal.json'),
   260	                          'B2_run_receipt_sha256':checkpoint['files']['r3m14_witness_run_receipt.json']['sha256'],
   261	                          'B2_prepared_receipt_sha256':prepared_info['receipt_sha256']},
   262	                claim_ceiling='Same-grid finite-span empirical temporal diagnostic only; all-bound/b-grid/rates OPEN')
   263	
   264	
   265	def main():
   266	    parser = argparse.ArgumentParser(description=__doc__)
   267	    parser.add_argument('--b2-run', type=Path, required=True)
   268	    parser.add_argument('--b2-prepared', type=Path, required=True)
   269	    parser.add_argument('--out', type=Path, required=True)
   270	    args = parser.parse_args()
   271	    if args.out.exists():
   272	        raise FileExistsError('preserve existing temporal evidence')
   273	    try:
   274	        value = analyze_b2(args.b2_run, args.b2_prepared)
   275	        write_new(args.out, value)
   276	    except Exception as exc:
   277	        failure = args.out.with_name(args.out.stem+'.failure.json')
   278	        if not failure.exists():
   279	            write_new(failure, {'status':'STRUCTURAL_OR_EVIDENCE_BLOCKED','type':type(exc).__name__,'message':str(exc)})
   280	        raise
   281	    print(json.dumps(value, indent=2, allow_nan=False))
   282	
   283	
   284	if __name__ == '__main__':
   285	    main()

