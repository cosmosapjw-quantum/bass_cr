actual=temporal.evaluate_result(run/'collision/result.json',run/'collision/r3m14_initial_binding.json',Path('results/R3M26/temporal/B3_FROZEN_FORECAST.json'))
assert actual==read(Path('results/R3M27/B3_TEMPORAL_EVALUATION.json'))==read(run/'B3_TEMPORAL_EVALUATION.json')
be=budget.evaluate_ledger(budget.load_json('results/R3M27/CURRENT_SELECTED_P3_LEDGER.json'));assert be==read(Path('results/R3M27/CURRENT_SELECTED_P3_EVALUATION.json'))
