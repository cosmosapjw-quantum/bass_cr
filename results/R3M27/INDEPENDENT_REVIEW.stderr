   237	def build_forecast_payload():
   238	    rows,cfg,initial=load_baseline()
   239	    cfg3=dict(cfg,dt=.00625)
   240	    horizon=rows['B2']['actual_dt']*rows['B2']['nstep']
   241	    n=math.ceil(horizon/cfg3['dt']); dt=horizon/n
   242	    if n!=7172 or dt!=rows['B2']['actual_dt']/2:raise ValueError('unexpected B3 integer schedule')
   243	    predictions={p:channel_forecasts([rows[k][p] for k in ('B0','B1','B2')],
   244	                                   [rows[k]['actual_dt'] for k in ('B0','B1','B2')],dt) for p in CHANNELS}
   245	    return {'schema':'BASS_CR_R3M26_FROZEN_FORECAST_PAYLOAD_V1','base_commit':BASE_COMMIT,
   246	            'numerical_source_digest':SOURCE,'initial_state_file_sha256':INITIAL_SHA,
   247	            'initial_array_digest':INITIAL_ARRAY,'initial_metadata':initial,'rows':rows,
   248	            'B3':{'config':cfg3,'nstep':n,'actual_dt':dt,'requested_dt':.00625,
   249	                  'preparation_contract':{'fresh_full_B3_config_receipt_required':True,
   250	                    'helper':'scripts/r3m13_initial_state_pair.py',
   251	                    'expected_initial_file_sha256':INITIAL_SHA,
   252	                    'expected_array_digest':INITIAL_ARRAY,
   253	                    'B2_receipt_relabel_or_reuse_allowed':False,
   254	                    'prepared_receipt_must_differ_from':B2_PREPARED_RECEIPT}},
   255	            'forecasts':predictions,'baseline_provenance':{
   256	                'B0_result':list(PINS['B0'][:2]),'B1_result':list(PINS['B1'][:2]),
   257	                'B2_result':list(B2_RESULT),'B2_witness':list(B2_WITNESS),'R18_summary':list(R18_SUMMARY)},
   258	            'criterion':{'relative_target':TOLERANCE,'factor':2.,
   259	                         'E_model':'max(abs(P_infinity_model-B3)) over four registered models',
   260	                         'D_hold':'max(abs(B3-frozen_forecast)) over three preregistered forecasts',
   261	                         'U_t':'2*max(E_model,D_hold)',
   262	                         'fine_increment_rule':'same sign and strict contraction on B1/B2/B3 only',
   263	                         'p_range':'1.5..2.5 diagnostic only','LOO':'all four even-degree-two residuals diagnostic only',
   264	                         'interpretation':'PROSPECTIVE_ENGINEERING_EMPIRICAL_ESTIMATE_NOT_CERTIFIED_BOUND'}}
   265	
   266	
   267	def freeze_forecast():
   268	    payload=build_forecast_payload(); digest=payload_hash(payload)
   269	    if digest!=EXPECTED_FORECAST_PAYLOAD_SHA256:raise ValueError('forecast payload differs from preregistered code pin')
   270	    return {'schema':'BASS_CR_R3M26_FORECAST_V1','payload':payload,'payload_sha256':digest,
   271	            'B3_execution_status':'NOT_RUN','production_admitted':False,'certified_error_bound':None,
   272	            'forecast_generated_before_B3':True,'instrumentation_sha256':sha(Path(__file__)),
   273	            'runtime':{'python':platform.python_version(),'numpy':np.__version__,'GPU_executed':False}}
