    60	def write_new(path, value):
    61	    path = Path(path)
    62	    path.parent.mkdir(parents=True, exist_ok=True)
    63	    with path.open('x') as stream:
    64	        json.dump(value, stream, indent=2, allow_nan=False)
    65	        stream.write('\n')
