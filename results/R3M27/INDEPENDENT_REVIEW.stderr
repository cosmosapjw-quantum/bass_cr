   116	def validate_witness(witness, cfg, initial_sha=INITIAL_SHA):
   117	    required = {
   118	        'schema': 'BASS_CR_R3M14_INTERNAL_INITIAL_BINDING_V2',
   119	        'status': 'PASS_BYTE_IDENTICAL_INTERNAL_INITIAL_TO_PREPARED',
   120	        'expected_source_digest': SOURCE, 'actual_source_digest': SOURCE,
   121	        'prepared_state_file_sha256': initial_sha,
   122	        'enriched_config_hash': config_hash(enriched(cfg)),
   123	        'array_digest_match': True, 'norm_match': True, 'environment_match': True,
   124	        'numerical_state_substituted': False, 'numerical_state_renormalized': False,
   125	    }
   126	    if any(witness.get(k) != v for k,v in required.items()):
   127	        raise ValueError('v2 witness/config/initial identity mismatch')
   128	    digest = witness.get('prepared_array_digest')
   129	    if (not isinstance(digest, str) or re.fullmatch(r'[0-9a-f]{64}', digest) is None or
   130	            witness.get('internal_array_digest') != digest):
   131	        raise ValueError('v2 internal/prepared array digest mismatch')
