import json,math,hashlib
from pathlib import Path
import numpy as np
from scripts import r3m26_temporal as temporal, r3m26_budget as budget, r3m27_b3_execute as b3
root=Path.cwd(); run=Path('/mnt/sn850x2t/bass_cr_r3m27_20260924/B3');read=lambda p:json.loads(p.read_text())
plan=read(root/'results/R3M27/CONTRACT.json')
b3.runtime_identity=lambda:plan['runtime'] # Stored runtime audited separately; no live CUDA query.
b3.validate_plan(plan,Path(plan['config_path']),run)
actual=temporal.evaluate_result(run/'collision/result.json',run/'collision/r3m14_initial_binding.json',Path('results/R3M26/temporal/B3_FROZEN_FORECAST.json'))
assert actual==read(root/'results/R3M27/B3_TEMPORAL_EVALUATION.json')
assert actual==read(run/'B3_TEMPORAL_EVALUATION.json')
ledger=budget.load_json(root/'results/R3M27/CURRENT_SELECTED_P3_LEDGER.json')
be=budget.evaluate_ledger(ledger);assert be==read(root/'results/R3M27/CURRENT_SELECTED_P3_EVALUATION.json')
forecast=read(root/'results/R3M26/temporal/B3_FROZEN_FORECAST.json')['payload']
for prov in read(root/'results/R3M27/CURRENT_SELECTED_P3_LEDGER.json')['provenance']:
 assert hashlib.sha256((root/prov['path']).read_bytes()).hexdigest()==prov['sha256']
print('Exact plan / temporal / Decimal budget outputs: MATCH')
for ch,c in actual['channels'].items():
 ys=np.array(c['values']);ts=np.array(c['actual_dt']);delta=np.diff(ys)
 # Independent polynomial interpolation at zero by Lagrange weights.
 def lagrange_zero(v,t):
  x=(np.array(t)/max(t))**2
  return float(sum(y*np.prod([-x[j]/(x[i]-x[j]) for j in range(len(x)) if i"'!=j]) for i,y in enumerate(v)))
 p=math.log(delta[1]/delta[2])/math.log(2)
 power=ys[3]+delta[2]/(2**p-1)
 p2=ys[3]+delta[2]/3
 even=lagrange_zero(ys[1:],ts[1:])
 # Independent linear least squares via numpy.polynomial polynomial fitter.
 four=float(np.polynomial.polynomial.polyfit((ts/ts[0])**2,ys,2)[0])
 model=max(abs(z-ys[3]) for z in (power,p2,even,four))
 hold=max(abs(ys[3]-v) for v in forecast['"'forecasts'][ch].values())
 u=2*max(model,hold);pair=delta[2]/ys[3]
 assert delta[1]*delta[2]>0 and abs(delta[2])<abs(delta[1])
 assert math.isclose(model,c['E_model'],rel_tol=2e-10,abs_tol=2e-17)
 assert u==c['U_t'] and pair==c['fine_pair_relative']
 assert math.isclose(p,c['fine_observed_order'],abs_tol=1e-11)
 print(json.dumps({'channel':ch,'B0_B1_B2_B3':ys.tolist(),'fine_deltas':delta[1:].tolist(),'fine_contraction_ratio':float(delta[2]/delta[1]),'order':p,'pair_percent':100*pair,'E_model':model,'D_hold':hold,'U_time':u,'U_percent':100*u/ys[3],'gate':bool(pair<=.001 and u/ys[3]<=.001)},ensure_ascii=False))
print('Budget',be['status'],'real_time',be['components']['real_time']['status'],'h_dt',be['h_dt']['status'],'total',be['additive_total_absolute_error'])
