   124	    read_text = subprocess.check_output([SCIENCE, '-B', '-c', code],
   125	                                        cwd=ROOT, env=_science_env(), text=True, timeout=60)
   126	    value = json.loads(read_text.strip())
   127	    required = dict(python='3.12.3', executable=SCIENCE, numpy='2.5.3',
   128	                    scipy='1.18.1', cupy='14.2.0', cuda_runtime=12090,
   129	                    cuda_driver_api=13020, device='NVIDIA GeForce RTX 3090')
   130	    if value != required:
   131	        raise ValueError(f'scientific runtime differs from frozen environment: {value}')
   132	    return value
