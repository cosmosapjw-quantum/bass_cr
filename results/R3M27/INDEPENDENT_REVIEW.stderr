 done=min(i*128,7172);gen=run/'generations'/f'g{done:06d}';mp=gen/'r3m17_generation_manifest.json';m=read(mp);rec=read(run/'receipts'/f'chunk{i:03d}.committed.json')
 assert m['done']==row['done']==rec['done']==done and row['chunk']==rec['chunk']==i
 assert sha(mp)==row['manifest_sha256']==rec['generation_manifest_sha256']
