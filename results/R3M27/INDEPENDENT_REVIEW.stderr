   169	def evaluate_ledger(ledger):
   170	    """Return arithmetic/evidence-type admission without changing any old gate."""
   171	    if not isinstance(ledger, dict) or ledger.get("schema") != SCHEMA:
   172	        raise ValueError("invalid ledger schema")
   173	    profile = ledger.get("profile")
   174	    if not isinstance(profile, str) or profile not in PROFILE_COMPONENTS:
   175	        raise ValueError("unknown completeness profile")
   176	    quantity = _quantity(ledger.get("quantity"), profile)
   177	    components, couplings = ledger.get("components"), ledger.get("couplings")
   178	    if not isinstance(components, dict) or not isinstance(couplings, dict):
   179	        raise ValueError("explicit component and coupling objects required")
   180	    required = PROFILE_COMPONENTS[profile]
   181	    if set(components) - set(required):
   182	        raise ValueError("component outside declared completeness profile")
   183	    if set(couplings) - {"h_dt"}:
   184	        raise ValueError("unsupported/unaccounted coupling")
   185	    rows, exact_errors = {}, {}
   186	    for name in required:
   187	        rows[name], exact_errors[name] = _row(name, components.get(name), quantity, profile, ALLOCATIONS[name])
   188	        included = (components.get(name) or {}).get("includes_couplings", [])
   189	        if included not in ([], ["h_dt"]) or (included and name != "spatial"):
   190	            raise ValueError("invalid or duplicate coupling accounting")
   191	    coupling_input = couplings.get("h_dt")
   192	    coupling, coupling_error = _row("h_dt", coupling_input, quantity, profile)
   193	    accounting = None if coupling_input is None else coupling_input.get("accounting")
   194	    spatial_includes = (components.get("spatial") or {}).get("includes_couplings", [])
   195	    if coupling_input is not None:
   196	        if accounting not in ("SEPARATE_ADDITIVE", "INCLUDED_IN_SPATIAL"):
   197	            raise ValueError("explicit h_dt accounting required")
   198	        if not _refs(coupling_input.get("accounting_evidence_refs")):
   199	            coupling["admitted"] = False
   200	            coupling["status"] = "UNADMITTED"
   201	            coupling["reasons"].append("MISSING_COUPLING_ACCOUNTING_EVIDENCE")
   202	        if accounting == "INCLUDED_IN_SPATIAL":
   203	            if spatial_includes != ["h_dt"]:
   204	                raise ValueError("spatial inclusion accounting must explicitly name h_dt")
   205	            spatial_error = exact_errors["spatial"]
   206	            if spatial_error is not None and coupling_error is not None and spatial_error < coupling_error:
   207	                raise ValueError("spatial error smaller than included h_dt coupling")
   208	        elif spatial_includes:
   209	            raise ValueError("h_dt double accounting: separate plus included")
   210	    elif spatial_includes:
   211	        # The spatial claim names a coupling but the required measured/estimated
   212	        # coupling row is absent. Preserve OPEN, never accept implied zero.
   213	        coupling["reasons"].append("SPATIAL_INCLUSION_HAS_NO_COUPLING_ROW")
   214	    all_admitted = all(row["admitted"] for row in rows.values()) and coupling["admitted"]
   215	    relative_target = sum((ALLOCATIONS[name] for name in required), Fraction(0))
   216	    absolute_target = relative_target * quantity["reference_value"]
   217	    total = None
   218	    if all_admitted:
   219	        total = sum(exact_errors.values(), Fraction(0))
   220	        if accounting == "SEPARATE_ADDITIVE":
   221	            total += coupling_error
   222	    exceeded_components = [name for name, row in rows.items()
   223	                           if row["admitted"] and row["reported_value_exceeds_allocation"]]
   224	    total_within = None if total is None else total <= absolute_target
   225	    status = ("NUMERICAL_BUDGET_EXCEEDED" if exceeded_components or total_within is False else
   226	              "NUMERICAL_BUDGET_SATISFIED_MODEL_CONDITIONAL" if all_admitted else "NUMERICAL_BUDGET_OPEN")
   227	    all_certified = all_admitted and all(row["evidence_class"] == "CERTIFIED_BOUND"
   228	                                        for row in [*rows.values(), coupling])
   229	    certified = None if not all_certified else dict(**_exact(total), units=ledger["quantity"]["units"],
   230	        scope="EXACT_SUM_OF_DECLARED_CERTIFIED_INPUT_BOUNDS_EVIDENCE_NOT_REPROVED_BY_LEDGER")
   231	    return dict(schema="BASS_CR_R3M26_BUDGET_EVALUATION_V1", profile=profile,
   232	                quantity=_display_tree(ledger["quantity"]), quantity_numeric_identity_exact=_identity_exact_tree(quantity),
   233	                status=status, required_components=list(required),
   234	                required_relative_total=_display(relative_target), required_absolute_total=_display(absolute_target),
   235	                required_absolute_total_exact=_exact(absolute_target), components=rows,
   236	                h_dt=dict(**coupling, accounting=accounting), all_required_evidence_admitted=all_admitted,
   237	                exceeded_components=exceeded_components, total_within_budget=total_within,
   238	                additive_total_absolute_error=None if total is None else _display(total),
   239	                additive_total_exact=None if total is None else _exact(total),
   240	                float_display_total_is_certified=False, certified_total_bound=certified,
   241	                combination="CONSERVATIVE_L1_NO_RSS_OR_INDEPENDENCE_ASSUMPTION",
   242	                external_validation=_display_tree(ledger.get("external_validation", {"status": "NOT_EVALUATED"})),
   243	                synthetic_fixture=ledger.get("synthetic_fixture", False),
   244	                production_admitted=False, historical_decisions_changed=False,
   245	                scope="DECLARED_QUANTITY_NUMERICAL_LEDGER_ONLY_NOT_WHOLE_PRODUCTION_OR_EXPERIMENTAL_VALIDATION")
   246	
   247	
   248	def projection_probability_error(p_num, delta):
   249	    """Floating evaluation of |p-p_num| <= 2 sqrt(p_num) delta + delta**2.
   250	
   251	    delta bounds ||psi-psi_num|| in the SAME Hilbert space and Q is an
   252	    orthogonal projector. This floating helper does not certify delta or rounding.
   253	    p_num=0 still has a meaningful absolute bound delta**2.
   254	    """
   255	    p = float(_number(p_num, "p_num"))
   256	    d = float(_number(delta, "delta"))
   257	    result = 2 * math.sqrt(p) * d + d * d
   258	    if not math.isfinite(result):
   259	        raise ValueError("probability-error formula overflows; no finite bound returned")
   260	    return result
   261	
   262	
   263	def sufficient_state_error(p_num, relative_goal):
   264	    """Stable floating inverse, relative to p_num>0; never define 0/0 as PASS."""
   265	    p = float(_number(p_num, "p_num for relative error", positive=True))
   266	    goal = float(_number(relative_goal, "relative_goal"))
   267	    result = math.sqrt(p) * (goal / (math.sqrt(1 + goal) + 1))
   268	    if not math.isfinite(result):
   269	        raise ValueError("state-error inverse overflows")
   270	    return result
   271	
   272	
   273	def load_json(path):
   274	    def unique(pairs):
   275	        obj = {}
   276	        for key, value in pairs:
   277	            if key in obj:
   278	                raise ValueError(f"duplicate JSON key: {key}")
   279	            obj[key] = value
   280	        return obj
   281	    def nonfinite(value):
   282	        raise ValueError(f"nonfinite JSON token: {value}")
   283	    return json.loads(Path(path).read_text(), object_pairs_hook=unique,
   284	                      parse_float=Decimal, parse_constant=nonfinite)
   285	
   286	
   287	def main():
   288	    parser = argparse.ArgumentParser(description=__doc__)
   289	    parser.add_argument("--ledger", required=True, type=Path)
   290	    parser.add_argument("--out", required=True, type=Path)
   291	    args = parser.parse_args()
   292	    result = evaluate_ledger(load_json(args.ledger))
   293	    with args.out.open("x") as stream:
   294	        json.dump(result, stream, indent=2, sort_keys=True, allow_nan=False)
   295	        stream.write("\n")
   296	    print(json.dumps(result, indent=2, sort_keys=True, allow_nan=False))
   297	
   298	
   299	if __name__ == "__main__":
   300	    main()

