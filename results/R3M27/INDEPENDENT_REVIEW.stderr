    72	def validate_result(result, expected_cfg):
    73	    if result.get('status') != 'completed' or result.get('config') != enriched(expected_cfg):
    74	        raise ValueError('completed result with exact config/source family required')
    75	    if result.get('backend') != expected_cfg['backend']:
    76	        raise ValueError('backend identity mismatch')
    77	    speed = projectile_speed_au(expected_cfg['energy_keV_per_u'])
    78	    horizon = (expected_cfg['z_stop'] - expected_cfg['z_start']) / speed
    79	    nstep = math.ceil(horizon / expected_cfg['dt'])
    80	    if (isinstance(result.get('nstep'), bool) or result.get('nstep') != nstep or
    81	            not math.isclose(result.get('dt_actual', math.nan), horizon/nstep,
    82	                             rel_tol=2e-14, abs_tol=0.0)):
    83	        raise ValueError('nstep/actual dt does not close frozen physical horizon')
    84	    if not math.isclose(result.get('v_au', math.nan), speed, rel_tol=2e-14):
    85	        raise ValueError('velocity/energy mismatch')
    86	    audit = result['analysis']['gram_audit']
    87	    expected_qns = [list(q) for q in bound_quantum_numbers(expected_cfg['project_nmax'])]
    88	    if (audit.get('quantum_numbers') != expected_qns or
    89	            audit.get('project_nmax') != expected_cfg['project_nmax']):
    90	        raise ValueError('projector channel identity mismatch')
    91	    eigen = audit['Gram_eigenvalues']
    92	    cond = audit['Gram_condition']
    93	    norms = audit['finite_grid_state_norms']
    94	    if (len(eigen) != 2 or not all(math.isfinite(x) for x in eigen) or
    95	            not 0 < eigen[0] <= eigen[1] or eigen[0] <= 1e-10*eigen[1] or
    96	            not math.isfinite(cond) or not math.isclose(cond, eigen[1]/eigen[0], rel_tol=1e-10) or
    97	            len(norms) != len(expected_qns) or not all(math.isfinite(x) and x > 0 for x in norms)):
    98	        raise ValueError('invalid projector Gram rank/condition/channel norms')
    99	    norm = audit['wavefunction_norm']
   100	    if not math.isfinite(norm) or not 0 < norm <= 1 + 2e-10:
   101	        raise ValueError('invalid contractive wavefunction norm')
   102	    spans = [audit['P_span_by_nmax'][str(n)] for n in (1, 2, 3)]
   103	    if (not all(math.isfinite(x) and 0 <= x <= norm*(1+5e-10) for x in spans)
   104	            or spans != sorted(spans)):
   105	        raise ValueError('invalid finite-span probability or nesting')
   106	    if not math.isfinite(audit['P_region']) or not 0 <= audit['P_region'] <= norm*(1+5e-10):
   107	        raise ValueError('invalid region probability')
   108	    residual = result['initial']['stationary_residual_Eh']
   109	    if not math.isfinite(residual) or residual < 0:
   110	        raise ValueError('invalid initial residual')
   111	    return dict(zip(('P1','P2','P3'), spans), actual_dt=result['dt_actual'],
   112	                requested_dt=expected_cfg['dt'], nstep=nstep, norm=norm,
   113	                initial_residual_Eh=residual)
