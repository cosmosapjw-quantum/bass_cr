   220	def load_baseline():
   221	    if source_digest()!=SOURCE:raise ValueError('frozen numerical source changed')
   222	    historic=historical_baseline()
   223	    rows={k:historic[k] for k in ('B0','B1')}
   224	    for cell in ('B0','B1'):
   225	        path,digest,cfgpath=PINS[cell]
   226	        _strict_result(read_json(ROOT/path),read_json(ROOT/cfgpath))
   227	    cfg=read_json(ROOT/'configs/r3m16/B1.json')
   228	    cfg2=dict(cfg,dt=.0125)
   229	    raw=_pinned(B2_RESULT); witness=_pinned(B2_WITNESS)
   230	    rows['B2']=dict(_strict_result(raw,cfg2),result_sha256=B2_RESULT[1])
   231	    _strict_witness(witness,cfg2,raw,raw['initial'])
   232	    summary=_pinned(R18_SUMMARY)
   233	    if canonical(rows)!=canonical(summary['rows']):raise ValueError('raw baseline and R3M18 summary disagree')
   234	    return rows,cfg,raw['initial']
