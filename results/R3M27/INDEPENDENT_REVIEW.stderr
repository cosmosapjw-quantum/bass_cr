print('Temporal / Decimal budget outputs: EXACT MATCH; known ledger provenance SHA discrepancy separately classified')
for ch,c in actual['channels'].items():
 ys=np.array(c['values']);ts=np.array(c['actual_dt']);delta=np.diff(ys)
 def lagrange_zero(v,t):
  x=(np.array(t)/max(t))**2
  return float(sum(y*np.prod([-x[j]/(x[i]-x[j]) for j in range(len(x)) if i"'!=j]) for i,y in enumerate(v)))
 p=math.log(delta[1]/delta[2])/math.log(2);power=ys[3]+delta[2]/(2**p-1);p2=ys[3]+delta[2]/3;even=lagrange_zero(ys[1:],ts[1:]);four=float(np.polynomial.polynomial.polyfit((ts/ts[0])**2,ys,2)[0])
 model=max(abs(z-ys[3]) for z in (power,p2,even,four));hold=max(abs(ys[3]-v) for v in forecast['"'forecasts'][ch].values());u=2*max(model,hold);pair=delta[2]/ys[3]
 assert delta[1]*delta[2]>0 and abs(delta[2])<abs(delta[1])
 assert math.isclose(model,c['E_model'],rel_tol=2e-10,abs_tol=2e-17)
 assert u==c['U_t'] and pair==c['fine_pair_relative'] and math.isclose(p,c['fine_observed_order'],abs_tol=1e-11)
 print(json.dumps({'channel':ch,'B3':float(ys[3]),'fine_deltas':delta[1:].tolist(),'fine_contraction_ratio':float(delta[2]/delta[1]),'order':p,'pair_percent':100*pair,'E_model':model,'D_hold':hold,'U_time':u,'U_percent':100*u/ys[3],'gate':bool(pair<=.001 and u/ys[3]<=.001)}))
