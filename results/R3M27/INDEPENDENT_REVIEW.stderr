   275	
   276	def evaluate_result(result_path,witness_path,forecast_path):
   277	    forecast=read_json(forecast_path)
   278	    if (forecast.get('schema')!='BASS_CR_R3M26_FORECAST_V1' or
   279	            forecast.get('payload_sha256')!=EXPECTED_FORECAST_PAYLOAD_SHA256 or
   280	            payload_hash(forecast.get('payload'))!=EXPECTED_FORECAST_PAYLOAD_SHA256):
   281	        raise ValueError('forecast does not match preregistered independent hash pin')
   282	    payload=forecast['payload']
   283	    rows,cfg,initial=load_baseline()
   284	    if canonical(payload['rows'])!=canonical(rows):raise ValueError('forecast historical raw identities disagree')
   285	    cfg3=dict(cfg,dt=.00625)
   286	    if canonical(payload['B3']['config'])!=canonical(cfg3):raise ValueError('B3 forecast config mismatch')
   287	    raw=read_json(result_path); witness=read_json(witness_path)
   288	    row=_strict_result(raw,cfg3)
   289	    _strict_witness(witness,cfg3,raw,initial)
   290	    if witness['prepared_receipt_sha256']==B2_PREPARED_RECEIPT:
   291	        raise ValueError('fresh B3 preparation receipt required; B2 receipt reuse forbidden')
   292	    if row['nstep']!=payload['B3']['nstep'] or row['actual_dt']!=payload['B3']['actual_dt']:
   293	        raise ValueError('B3 actual dt differs from frozen forecast schedule')
   294	    channels={p:channel_gate([rows[k][p] for k in ('B0','B1','B2')]+[row[p]],
   295	                             [rows[k]['actual_dt'] for k in ('B0','B1','B2')]+[row['actual_dt']],
   296	                             payload['forecasts'][p]) for p in CHANNELS}
   297	    accepted=all(ch['accepted'] for ch in channels.values())
   298	    return {'schema':'BASS_CR_R3M26_TEMPORAL_EVALUATION_V1',
   299	            'status':ACCEPTED if accepted else 'TEMPORAL_ESTIMATE_NOT_VALIDATED',
   300	            'claim_scope':'FIXED_H_SELECTED_P1_P2_P3_EMPIRICAL_TEMPORAL_ESTIMATE_ONLY',
   301	            'channels':channels,'raw_B3_row':row,'certified_error_bound':None,
   302	            'production_admitted':False,'total_error_budget_closed':False,
   303	            'representation_change_admitted':False,
   304	            'identity_basis':'PINNED_HISTORICAL_RAW_RESULTS_PLUS_SUBMITTED_B3_RAW_RESULT_AND_V2_WITNESS',
   305	            'array_restore_or_checkpoint_rehash_performed':False,
   306	            'input_files':{key:{'path':str(path),'sha256':sha(path)} for key,path in
   307	                           (('result',result_path),('witness',witness_path),('forecast',forecast_path))},
   308	            'forecast_payload_sha256':EXPECTED_FORECAST_PAYLOAD_SHA256,
   309	            'numerical_source_digest':source_digest(),'instrumentation_sha256':sha(Path(__file__))}
   310	
   311	
   312	def main():
   313	    parser=argparse.ArgumentParser(description=__doc__)
   314	    sub=parser.add_subparsers(dest='command',required=True)
   315	    first=sub.add_parser('forecast'); first.add_argument('--out',required=True,type=Path)
   316	    second=sub.add_parser('evaluate')
   317	    for flag in ('result','witness','forecast','out'):second.add_argument('--'+flag,required=True,type=Path)
   318	    args=parser.parse_args()
   319	    if args.out.exists():raise FileExistsError(args.out)
   320	    result=freeze_forecast() if args.command=='forecast' else evaluate_result(args.result,args.witness,args.forecast)
   321	    write_new(args.out,result)
   322	    print(json.dumps({'output':str(args.out),'status':result.get('status','FORECAST_ONLY_B3_NOT_RUN'),
   323	                      'production_admitted':False}))
   324	
   325	
   326	if __name__=='__main__':main()

