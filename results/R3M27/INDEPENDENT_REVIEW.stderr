    51	
    52	def _number(value, name, *, positive=False):
    53	    if (type(value) not in (int, float, Decimal)
    54	            or (type(value) is float and not math.isfinite(value))
    55	            or (type(value) is Decimal and not value.is_finite())):
    56	        raise ValueError(f"{name} must be a finite number, not bool/string")
    57	    if value < 0 or (positive and value == 0):
    58	        raise ValueError(f"{name} must be {'positive' if positive else 'nonnegative'}")
    59	    return Fraction(str(value))
    60	
    61	
    62	def _nonempty(value):
    63	    return isinstance(value, str) and bool(value.strip())
    64	
    65	
    66	def _refs(value):
    67	    return isinstance(value, list) and bool(value) and all(_nonempty(item) for item in value)
    68	
    69	
    70	def _quantity(value, profile):
    71	    if not isinstance(value, dict) or set(value) != QUANTITY_KEYS:
    72	        raise ValueError("explicit complete quantity identity required")
    73	    for key in ("model_id", "observable_id", "observable_scope", "units"):
    74	        if not _nonempty(value[key]):
    75	            raise ValueError(f"invalid quantity {key}")
    76	    expected_scope = "SELECTED_SPANS" if profile == "SELECTED_SPANS_SINGLE_B" else "ALL_BOUND"
    77	    if value["observable_scope"] != expected_scope:
    78	        raise ValueError("observable completeness scope does not match profile")
    79	    normalized = dict(value)
    80	    normalized["energy_keV_per_u"] = _number(value["energy_keV_per_u"], "energy", positive=True)
    81	    normalized["reference_value"] = _number(value["reference_value"], "reference_value", positive=True)
    82	    domain = value["domain"]
    83	    if profile == "ALL_BOUND_CROSS_SECTION":
    84	        if domain != {"kind": "B_INTEGRATED_FROM_ZERO_TO_INFINITY"} or value["units"] != "a0^2":
    85	            raise ValueError("cross-section domain/units require all-b integral in a0^2")
    86	    else:
    87	        if not isinstance(domain, dict) or set(domain) != {"kind", "b_a0"} or domain["kind"] != "SINGLE_B":
    88	            raise ValueError("single-b domain required")
    89	        if value["units"] != "dimensionless":
    90	            raise ValueError("single-b probability units must be dimensionless")
    91	        normalized["domain"] = {"kind": "SINGLE_B", "b_a0": _number(domain["b_a0"], "impact parameter")}
    92	    return normalized
