    97	def _p2_fit(values,dt,query=0.):
    98	    ratio=(dt[1]/dt[0])**2
    99	    slope=(values[0]-values[1])/(1-ratio)
   100	    central=values[0]-slope
   101	    return float(central+slope*(query/dt[0])**2)
   102	
   103	
   104	def _single_power(values,dt):
   105	    fit=temporal_triplet(values,dt)
   106	    p=fit['observed_order']; central=fit['extrapolated_value']
   107	    if p is None or central is None:return None
   108	    return float(p),float(central)
   109	
   110	
   111	def channel_forecasts(values,actual_dt,next_actual_dt):
   112	    values=_probabilities(values,3); dt=_steps(actual_dt,3)
   113	    nxt=number(next_actual_dt,'next actual dt',positive=True)
   114	    if nxt>=dt[-1]:raise ValueError('forecast dt must refine existing finest dt')
   115	    fit=_single_power(values,dt)
   116	    if fit is None:raise ValueError('old triplet single-power forecast is unresolved')
   117	    p,central=fit
   118	    return dict(zip(FORECAST_KEYS,(
   119	        float(central-(central-values[-1])*(nxt/dt[-1])**p),
   120	        _even_fit(values,dt,nxt),_p2_fit(values[-2:],dt[-2:],nxt))))
   121	
   122	
   123	def channel_gate(values,actual_dt,frozen_forecasts):
   124	    """Arithmetic kernel only. Caller numbers have no raw-evidence authority."""
   125	    v=_probabilities(values,4); dt=_steps(actual_dt,4)
   126	    if set(frozen_forecasts)!=set(FORECAST_KEYS):raise ValueError('three registered forecast models required')
   127	    f={k:number(frozen_forecasts[k],'forecast',positive=True) for k in FORECAST_KEYS}
   128	    changes=[v[2]-v[1],v[3]-v[2]]
   129	    floor=64*np.finfo(float).eps*max(v)
   130	    out={'accepted':False,'status':'UNRESOLVED_FINE_DIFFERENCES',
   131	         'evidence_scope':'SYNTHETIC_OR_CALLER_VALUES_NOT_RAW_EVIDENCE',
   132	         'values':v,'actual_dt':dt,'fine_signed_changes':changes,
   133	         'fine_pair_absolute':abs(changes[-1]),'fine_pair_relative':abs(changes[-1])/v[-1],
   134	         'relative_denominator_B3':v[-1],'roundoff_resolution_floor':floor,
   135	         'relative_target':TOLERANCE,'certified_error_bound':None,
   136	         'fine_observed_order':None,'clean_p2_diagnostic':None,
   137	         'infinite_step_estimates':None,'E_model':None,'D_hold':None,'U_t':None,'U_t_relative':None,
   138	         'leave_one_out_even_diagnostics':[],
   139	         'central_value':v[-1],'central_semantics':'OBSERVED_B3_SELECTED_SPAN_NOT_EXTRAPOLATED_PRODUCTION_CENTRAL'}
   140	    if min(map(abs,changes))<=floor:return out
   141	    if changes[0]*changes[1]<=0:
   142	        out['status']='SIGN_CHANGE_NONASYMPTOTIC'; return out
   143	    if abs(changes[1])>=abs(changes[0]):
   144	        out['status']='NO_FINE_CONTRACTION'; return out
   145	    fit=_single_power(v[1:],dt[1:])
   146	    if fit is None:
   147	        out['status']='FINE_SINGLE_POWER_MODEL_UNRESOLVED'; return out
   148	    p,pinf=fit
   149	    estimates={'fine_p2':_p2_fit(v[2:],dt[2:]),
   150	               'fine_even_dt2_dt4':_even_fit(v[1:],dt[1:]),
   151	               'all_four_even_least_squares':_even_fit(v,dt),
   152	               'fine_triplet_single_power':pinf}
   153	    if not all(math.isfinite(x) and 0<x<=1+2e-10 for x in estimates.values()):
   154	        out['status']='UNPHYSICAL_OR_NONFINITE_MODEL_ESTIMATE'; return out
   155	    loo=[]
   156	    for omitted in range(4):
   157	        ix=[j for j in range(4) if j!=omitted]
   158	        predicted=_even_fit([v[j] for j in ix],[dt[j] for j in ix],dt[omitted])
   159	        loo.append({'omitted_cell':f'B{omitted}','predicted':predicted,
   160	                    'signed_residual':v[omitted]-predicted,'diagnostic_only':True})
   161	    e=max(abs(x-v[-1]) for x in estimates.values())
   162	    d=max(abs(v[-1]-x) for x in f.values()); u=2*max(e,d)
   163	    accepted=out['fine_pair_relative']<=TOLERANCE and u/v[-1]<=TOLERANCE
   164	    out.update(accepted=accepted,status=ACCEPTED if accepted else 'EMPIRICAL_TEMPORAL_BUDGET_OPEN',
   165	               fine_observed_order=p,clean_p2_diagnostic=1.5<=p<=2.5,
   166	               infinite_step_estimates=estimates,E_model=e,D_hold=d,U_t=u,U_t_relative=u/v[-1],
   167	               leave_one_out_even_diagnostics=loo,
   168	               rule='same-sign contracting B1/B2/B3 increments; pair<=0.001; 2*max(E_model,D_hold)/B3<=0.001',
   169	               p_range_is_veto=False,coarsest_LOO_residual_is_veto=False)
   170	    return out
   171	
