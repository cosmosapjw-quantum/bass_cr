assert sha(forecast)==contract['forecast_sha256']
assert hashlib.sha256(subprocess.check_output(['git','show',contract['parent_commit']+':'+str(forecast.relative_to(root))])).hexdigest()==sha(forecast)
assert sha(root/'results/R3M27/FULL_GENERATION_AUDIT.json')==runtime['full_generation_audit_sha256']
cmdreceipts=[]
for spec in contract['commands']:
 phase=spec['phase']; label={'resource':'resource_preflight','prepare':'prepare'}.get(phase)
 if label is None:label=f\"collision.chunk{spec['chunk']:03d}\" if phase=='collision' else f\"snapshot.g{spec['done']:06d}\"
 rec=read(run/'receipts'/f'{label}.json');assert rec['argv']==spec['argv'] and rec['phase']==phase and rec['exit_code']==0 and rec['stop_reason'] is None
 for ext in ('stdout','stderr'):assert sha(run/f'{label}.{ext}')==rec[ext+'_sha256']
 assert rec['wall_seconds']<=contract['resources']['command_seconds_cap'][phase]
 cmdreceipts.append(rec)
