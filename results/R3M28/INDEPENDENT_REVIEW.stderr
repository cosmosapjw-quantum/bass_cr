for spec in p['commands']:
 phase=spec['phase']; label={'resource':'resource_preflight','prepare':'prepare'}.get(phase)
 if phase=='collision': label=f\"collision.chunk{spec['chunk']:03d}\"
 if phase=='snapshot':label=f\"snapshot.g{spec['done']:06d}\"
 row=read(root/'receipts'/f'{label}.json');assert row['argv']==spec['argv'] and row['phase']==phase
 assert row['exit_code']==0 and row['stop_reason'] is None,label
 for stream in ('stdout','stderr'):assert row[f'{stream}_sha256']==sha(root/f'{label}.{stream}'),label
 command_rows.append(row)
sums={phase:sum(x['wall_seconds'] for x in command_rows if x['phase']==phase) for phase in ('resource','prepare','collision','snapshot')}
assert sums==rt['phase_command_wall_seconds'];assert math.isclose(sum(sums.values()),rt['total_command_wall_seconds'],abs_tol=1e-9)
for kind in ('disk_free','gpu_free','host_available'):
 key=f'minimum_sampled_{kind}_bytes';assert min(x[key] for x in command_rows)==rt[key],key
