    60	                             rel_tol=0, abs_tol=1e-16) or
    61	            not math.isclose(numerical['physical_horizon_au'], 44.821139751290325,
    62	                             rel_tol=0, abs_tol=1e-11)):
    63	        raise ValueError('A3 physical horizon, dt or geometry changed')
    64	    return numerical
    65	
    66	
    67	def build_plan(config: Path, output_root: Path) -> dict:
    68	    config, output_root = Path(config).absolute(), Path(output_root).absolute()
    69	    if config != CONFIG or output_root == ROOT or ROOT in output_root.parents:
    70	        raise ValueError('canonical A3 config and external output root required')
    71	    cfg = base.read(config)
    72	    numerical = validate_config(cfg)
    73	    pins = ((A1_RESULT, A1_RESULT_SHA), (B1_RESULT, B1_RESULT_SHA),
    74	            (B3_RESULT, B3_RESULT_SHA), (A1_INITIAL, INITIAL_SHA))
    75	    for path, digest in pins:
    76	        if base.sha(path) != digest:
    77	            raise ValueError(f'preregistered input bytes changed: {path}')
    78	    design = base.read(DESIGN)
    79	    if (design.get('schema') != 'R3M28_SPATIAL_HDT_DESIGN_V1' or
    80	            design.get('created_before_A3') is not True or
    81	            design.get('A3_config_sha256') != base.sha(config) or
    82	            design.get('spatial_pair_screen_relative') != .003 or
    83	            design.get('A3_initial_reference_sha256') != INITIAL_SHA):
    84	        raise ValueError('spatial design differs from preregistration')
    85	    head = base.git('rev-parse', 'HEAD')
    86	    if (base.git('branch', '--show-current') != 'cr/r3m28-spatial-hdt-budget-20260924' or
    87	            base.git('merge-base', PARENT, head) != PARENT or head == PARENT):
    88	        raise ValueError('committed R3M28 descendant branch required')
    89	    return dict(schema='BASS_CR_R3M28_A3_CONTRACT_V1',
    90	        canonical_node='N1_TDL_PRODUCTION_H_SPATIAL_H_DT_BUDGET',
    91	        hypothesis='One same-horizon A3 point discriminates the spatial .30% pair screen and raw h-dt interaction.',
    92	        source_commit=head, parent_commit=PARENT, source_digest=SOURCE,
    93	        source_hashes={name: base.sha(ROOT/name) for name in SOURCE_PATHS},
    94	        config=cfg, config_path=str(config), config_sha256=base.sha(config),
    95	        design_sha256=base.sha(DESIGN), numerical=numerical,
    96	        input_hashes={str(path): digest for path, digest in pins},
    97	        runtime=base.runtime_identity(), output_root=str(output_root),
    98	        commands=base.command_plan(config, output_root),
    99	        resource_caps=dict(base_plan_disk_required_free_bytes=base.DISK_REQUIRED,
   100	            disk_remaining_floor_bytes=base.DISK_REMAIN,
   101	            gpu_free_reserve_bytes=base.GPU_RESERVE,
   102	            host_available_reserve_bytes=base.HOST_RESERVE,
   103	            max_total_seconds=base.TOTAL_SECONDS,
   104	            command_seconds_cap=base.COMMAND_SECONDS,
   105	            cpu_workers=1, state_bytes=STATE_BYTES,
   106	            retained_generations=CHUNKS,
   107	            generation_state_bytes=STATE_BYTES*CHUNKS),
   108	        spatial_pair_screen_relative=.003,
   109	        pair_screen_is_validated_error_estimate=False,
   110	        h_dt_raw_interaction_counted_as_error_estimate=False,
   111	        new_full_collision_limit=1, exact_preparation_limit=1,
   112	        automatic_retry=False, production_admission=False)
   113	
   114	
   115	def validate_plan(plan: dict) -> None:
   116	    expected = build_plan(Path(plan['config_path']), Path(plan['output_root']))
   117	    frozen_head = plan.get('source_commit')
   118	    current_head = expected['source_commit']
   119	    if (not isinstance(frozen_head, str) or
   120	            (frozen_head != current_head and
   121	             base.git('merge-base', frozen_head, current_head) != frozen_head)):
   122	        raise ValueError('A3 source commit is not an ancestor of current checkout')
   123	    # Delivery commits may follow the frozen source commit. Exact source hashes
   124	    # still reject code changes; they need not invalidate a result-only commit.
   125	    expected['source_commit'] = frozen_head
   126	    if json.dumps(plan, sort_keys=True, allow_nan=False) != json.dumps(expected, sort_keys=True, allow_nan=False):
   127	        raise ValueError('A3 config/argv/source/runtime/resource contract mismatch')
   128	
   129	
   130	def _prepared(root: Path, cfg: dict) -> dict:
   131	    from scripts.r3m14_collision_initial_witness import validate_prepared
   132	    prepared = validate_prepared(root/'preparation', cfg, SOURCE)
   133	    if (prepared['state_file_sha256'] != INITIAL_SHA or
   134	            prepared['receipt']['config'] != cfg):
   135	        raise ValueError('fresh A3 preparation differs from A1 canonical initial/config')
   136	    return prepared
   137	
   138	
   139	def execute(contract: Path, approval: str, *, explicit_resume: bool = False) -> dict:
   140	    contract = Path(contract).absolute()
   141	    if base.sha(contract) != approval:
   142	        raise ValueError('explicit A3 contract SHA approval mismatch')
   143	    plan = base.read(contract)
   144	    validate_plan(plan)
   145	    root = Path(plan['output_root'])
   146	    if root.exists() and not explicit_resume:
   147	        raise FileExistsError('fresh A3 output required')
   148	    if not root.exists():
   149	        root.mkdir(parents=True, exist_ok=False)
   150	        base.publish(root/'RUN.json', dict(contract_sha256=approval,
   151	            source_commit=plan['source_commit'], new_full_collisions=1,
   152	            automatic_retry=False, production_admission=False))
   153	    elif base.read(root/'RUN.json')['contract_sha256'] != approval:
   154	        raise ValueError('resume contract SHA mismatch')
   155	    (root/'receipts').mkdir(exist_ok=True)
   156	    (root/'generations').mkdir(exist_ok=True)
   157	    started = time.monotonic()
   158	    stage = 'RESOURCE_PREFLIGHT'
   159	    with (root/'gpu.lock').open('a+') as lock:
   160	        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
   161	        try:
   162	            if (root/'COMPLETE.json').exists():
   163	                raise FileExistsError('completed A3 must not rerun')
   164	            if not (root/'RESOURCE_INVENTORY.json').exists():
   165	                base.publish(root/'RESOURCE_INVENTORY.json', base.resources(root))
   166	            else:
   167	                base.resources(root)
   168	            if not (root/'resource.json').exists():
   169	                base._command('resource_preflight', plan['commands'][0], root, started)
   170	            if not (root/'receipts/resource_preflight.json').is_file():
   171	                raise ValueError('resource output without completed command receipt')
   172	            if base.read(root/'resource.json').get('status') != 'PASS_RESOURCE_PREFLIGHT':
   173	                raise ValueError('FFT resource preflight did not pass')
   174	            stage = 'PREPARATION'
   175	            if not (root/'preparation').exists():
   176	                base._command('prepare', plan['commands'][1], root, started)
   177	            if not (root/'receipts/prepare.json').is_file():
   178	                raise ValueError('preparation output without completed command receipt')
   179	            prepared = _prepared(root, plan['config'])
   180	            if not (root/'PREPARATION_BINDING.json').exists():
   181	                base.publish(root/'PREPARATION_BINDING.json', dict(
   182	                    status='PASS_EXACT_A3_CONFIG_AND_A1_CANONICAL_INITIAL',
   183	                    receipt_sha256=prepared['receipt_sha256'],
   184	                    initial_sha256=prepared['state_file_sha256'],
   185	                    seconds=prepared['receipt']['seconds'],
   186	                    internal_preparation_expected_once_on_first_collision_chunk=True))
   187	            commands = plan['commands'][2:]
   188	            for i in range(CHUNKS):
   189	                collision, snapshot = commands[2*i:2*i+2]
   190	                chunk, expected = i+1, snapshot['done']
   191	                stage = f'COLLISION_CHUNK_{chunk:03d}'
   192	                if source_digest() != SOURCE:
   193	                    raise ValueError('frozen numerical source changed before chunk')
   194	                generation = root/'generations'/f'g{expected:06d}'
   195	                if generation.exists():
   196	                    base.validate_generation(generation, plan['config'], expected)
   197	                    continue
   198	                active = root/'collision'
   199	                done = guard.validate_checkpoint(active, plan['config'])['done'] if (active/'state.json').exists() else 0
   200	                action = base.frontier_action(chunk, done, expected, False)
   201	                if action == 'RUN_CHUNK':
   202	                    base._command(f'collision.chunk{chunk:03d}', collision, root, started)
   203	                    if guard.validate_checkpoint(active, plan['config'])['done'] != expected:
   204	                        raise ValueError('writer returned outside exact A3 frontier')
   205	                stage = f'SNAPSHOT_CHUNK_{chunk:03d}'
   206	                base._command(f'snapshot.g{expected:06d}', snapshot, root, started)
   207	                manifest = base.validate_generation(generation, plan['config'], expected)
   208	                base.publish(root/'receipts'/f'chunk{chunk:03d}.committed.json', dict(
   209	                    status='CHUNK_AND_GENERATION_COMMITTED', chunk=chunk, done=expected,
   210	                    generation_manifest_sha256=base.sha(generation/guard.MANIFEST_NAME),
   211	                    state_sha256=manifest['files']['state.npy']['sha256'],
   212	                    next_chunk_authorized=chunk<CHUNKS))
   213	            stage = 'FINAL_AUDIT'
   214	            final = guard.validate_checkpoint(root/'collision', plan['config'])
   215	            result = base.read(root/'collision/result.json')
   216	            if final['done'] != NSTEP or result.get('status') != 'completed':
   217	                raise ValueError('A3 final result/checkpoint incomplete')
   218	            complete = dict(status='COMPLETE', job='A3', chunks=CHUNKS,
   219	                retained_generations=CHUNKS, done=NSTEP, nstep=NSTEP,
   220	                contract_sha256=approval,
   221	                preparation_receipt_sha256=prepared['receipt_sha256'],
   222	                result_sha256=base.sha(root/'collision/result.json'),
   223	                final_generation_manifest_sha256=base.sha(root/'generations'/'g007172'/guard.MANIFEST_NAME),
   224	                new_full_collisions=1, production_admission=False)
   225	            base.publish(root/'COMPLETE.json', complete)
   226	            return complete
   227	        except BaseException as exc:
   228	            failure = root/'FIRST_FAILURE.json'
   229	            if not failure.exists():
   230	                try:
   231	                    base.publish(failure, dict(stage=stage, exception_type=type(exc).__name__,
   232	                        message=str(exc), traceback=traceback.format_exc(),
   233	                        automatic_retry=False, scientific_nonconvergence='UNDETERMINED',
   234	                        completed_generations=len(list((root/'generations').glob('g*/r3m17_generation_manifest.json'))),
   235	                        production_admission=False))
   236	                except BaseException:
   237	                    pass
   238	            raise
   239	
   240	
   241	def main() -> None:
   242	    parser = argparse.ArgumentParser(description=__doc__)
   243	    sub = parser.add_subparsers(dest='command', required=True)
   244	    f = sub.add_parser('freeze')
   245	    f.add_argument('--config', type=Path, default=CONFIG)
   246	    f.add_argument('--root', type=Path, required=True)
   247	    f.add_argument('--contract', type=Path, required=True)
   248	    r = sub.add_parser('run')
   249	    r.add_argument('--contract', type=Path, required=True)
   250	    r.add_argument('--approve-sha256', required=True)
   251	    r.add_argument('--explicit-resume', action='store_true')
   252	    args = parser.parse_args()
   253	    if args.command == 'freeze':
   254	        dirty = base.git('status', '--porcelain', '--',
   255	            'scripts/r3m28_execute.py', 'scripts/r3m28_spatial.py',
   256	            'tests/test_r3m28_execute.py', 'tests/test_r3m28_spatial.py',
   257	            'configs/r3m28/A3.json', 'results/R3M28/DESIGN.json')
   258	        if dirty:
   259	            raise ValueError('commit A3 source/config/design/tests before freeze')
   260	        if args.root.exists():
   261	            raise FileExistsError('fresh A3 output root required')
   262	        plan = build_plan(args.config, args.root)
   263	        base.resources(args.root)
   264	        base.publish(args.contract, plan)
   265	        base.publish(args.contract.with_name('HASH_MANIFEST.json'), dict(
   266	            contract_sha256=base.sha(args.contract),
   267	            config_sha256=plan['config_sha256'],
   268	            design_sha256=plan['design_sha256'],
   269	            source_hashes=plan['source_hashes'],
   270	            output_root=plan['output_root']))
   271	        print(json.dumps(dict(contract=str(args.contract),
   272	                              sha256=base.sha(args.contract),
   273	                              generations=CHUNKS, gpu_work=0)))
   274	    else:
   275	        print(json.dumps(execute(args.contract, args.approve_sha256,
   276	                                 explicit_resume=args.explicit_resume), sort_keys=True))
   277	
   278	
   279	if __name__ == '__main__':
   280	    main()
     1	import json
     2	from pathlib import Path
     3	
     4	import pytest
     5	
     6	from scripts import r3m28_execute as job
     7	
     8	
     9	def test_a3_config_only_changes_requested_dt():
    10	    cfg = job.base.read(job.CONFIG)
    11	    assert job.validate_config(cfg)['nstep'] == 7172
    12	    with pytest.raises(ValueError):
    13	        job.validate_config(dict(cfg, absorber_width=4.1))
    14	    with pytest.raises(ValueError):
    15	        job.validate_config(dict(cfg, dt=.0125))
    16	
    17	
    18	def test_exact_commands_and_frontier_reuse():
    19	    commands = job.base.command_plan(job.CONFIG, Path('/tmp/r3m28-fixture'))
    20	    assert len(commands) == 116
    21	    collisions = [x for x in commands if x['phase'] == 'collision']
    22	    assert len(collisions) == 57
    23	    assert collisions[-1]['done'] == 7172 and collisions[-1]['steps'] == 4
    24	    assert all(str(job.CONFIG) in x['argv'] for x in commands)
    25	    assert job.base.frontier_action(57, 7168, 7172, False) == 'RUN_CHUNK'
    26	    assert job.base.frontier_action(57, 7172, 7172, False) == 'PUBLISH_ONLY'
    27	    assert job.base.frontier_action(57, 7172, 7172, True) == 'SKIP_VERIFIED_GENERATION'
    28	    with pytest.raises(ValueError):
    29	        job.base.frontier_action(57, 7000, 7172, False)
    30	
    31	
    32	def test_plan_tamper_rejected_without_gpu(monkeypatch, tmp_path):
    33	    monkeypatch.setattr(job.base, 'runtime_identity', lambda: {'fixture': True})
    34	    original_sha = job.base.sha
    35	    monkeypatch.setattr(job.base, 'sha', lambda path: job.INITIAL_SHA
    36	                        if Path(path) == job.A1_INITIAL else original_sha(path))
    37	    monkeypatch.setattr(job.base, 'git', lambda *args:
    38	                        'cr/r3m28-spatial-hdt-budget-20260924' if args[0] == 'branch'
    39	                        else 'test-commit' if args[0] == 'rev-parse' else job.PARENT)
    40	    plan = job.build_plan(job.CONFIG, tmp_path/'A3')
    41	    job.validate_plan(plan)
    42	    altered = json.loads(json.dumps(plan))
    43	    altered['commands'][2]['argv'][-1] = '256'
    44	    with pytest.raises(ValueError, match='contract mismatch'):
    45	        job.validate_plan(altered)
    46	    altered = json.loads(json.dumps(plan))
    47	    altered['config']['dt'] = .0125
    48	    with pytest.raises(ValueError, match='contract mismatch'):
    49	        job.validate_plan(altered)
    50	
    51	
    52	def test_existing_output_refused_before_gpu(monkeypatch, tmp_path):
    53	    root = tmp_path/'used'
    54	    root.mkdir()
    55	    contract = tmp_path/'CONTRACT.json'
    56	    contract.write_text(json.dumps({'output_root': str(root), 'config_path': str(job.CONFIG)}))
    57	    monkeypatch.setattr(job, 'validate_plan', lambda _: None)
    58	    with pytest.raises(FileExistsError, match='fresh A3'):
    59	        job.execute(contract, job.base.sha(contract))

