     1	"""R3M14 fail-closed wrapper binding the actual collision initial state to R3M13 prep.
     2	
     3	The numerical evolution remains entirely in
     4	``cr_repro.r3m11.ControlledTDLRunner``.  This sidecar reuses the canonical
     5	R3M13 preparation loader as the preparation-state SSOT, observes the exact
     6	state returned by the inherited ``relaxed_initial()``, records an identity
     7	witness before the first real-time step, and returns the original state object
     8	unchanged.
     9	"""
    10	from __future__ import annotations
    11	
    12	import argparse
    13	import hashlib
    14	import importlib.util
    15	import json
    16	import math
    17	import platform
    18	from pathlib import Path
