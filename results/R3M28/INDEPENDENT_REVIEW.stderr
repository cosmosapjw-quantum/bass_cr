 seal=read(g/'r3m11_checkpoint_seal.json');assert all(seal['files'][k]==gm['files'][k]['sha256'] for k in ('state.npy','state.json'))
 receipt=read(g/'r3m14_witness_run_receipt.json');assert receipt['done']==done and receipt['state_npy_sha256']==row['state_sha256']
 commit=read(root/'receipts'/f'chunk{i:03d}.committed.json');assert commit['done']==done and commit['generation_manifest_sha256']==row['manifest_sha256'] and commit['state_sha256']==row['state_sha256']
 total+=gm['files']['state.npy']['size']
assert len(audit['rows'])==len(list((root/'generations').iterdir()))==57
assert total==audit['total_state_bytes']==p['resource_caps']['generation_state_bytes']
complete=read(root/'COMPLETE.json');assert complete['result_sha256']==sha(root/'collision/result.json')==audit['result_sha256']
