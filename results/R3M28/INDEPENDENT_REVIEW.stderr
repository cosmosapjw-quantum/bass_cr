    26	EXPECTED_SOURCE_DIGEST = (
    27	    "581ff84930bb862efafdfec5d39d5b25aebf9297ce7ce45f833a5abe125b2a5b"
    28	)
    29	SCHEMA = "BASS_CR_R3M14_INTERNAL_INITIAL_BINDING_V2"
    30	ROOT = Path(__file__).resolve().parents[1]
    31	R3M13_HELPER = ROOT / "scripts/r3m13_initial_state_pair.py"
    32	NORM_TOL = 2e-10
    33	HASH_CHUNK_BYTES = 16 * 1024 * 1024
    34	NORM_CHUNK_ELEMENTS = 1 << 20
    35	
    36	
    37	def load_json(path: Path):
    38	    def hook(pairs):
    39	        out = {}
    40	        for key, value in pairs:
    41	            if key in out:
    42	                raise ValueError(f"duplicate JSON key: {key}")
    43	            out[key] = value
    44	        return out
    45	
    46	    def bad_constant(token):
    47	        raise ValueError(f"nonfinite JSON: {token}")
    48	
    49	    return json.loads(
    50	        Path(path).read_text(),
    51	        object_pairs_hook=hook,
    52	        parse_constant=bad_constant,
    53	    )
    54	
    55	
    56	def canonical_json(obj) -> str:
    57	    return json.dumps(obj, sort_keys=True, separators=(",", ":"), allow_nan=False)
    58	
    59	
    60	def load_r3m13_helper():
    61	    """Load the checked-out canonical R3M13 helper without copying its logic."""
    62	    spec = importlib.util.spec_from_file_location(
    63	        "_bass_cr_r3m13_initial_state_pair", R3M13_HELPER
    64	    )
    65	    if spec is None or spec.loader is None:
    66	        raise ValueError("cannot load canonical R3M13 helper")
    67	    module = importlib.util.module_from_spec(spec)
    68	    spec.loader.exec_module(module)
    69	    return module
    70	
    71	
    72	def runtime_environment(backend: str) -> dict:
    73	    """Record exact runtime identity used for the witness and restart binding."""
    74	    env = {
    75	        "python": platform.python_version(),
    76	        "numpy": np.__version__,
    77	        "backend": backend,
    78	    }
    79	    try:
    80	        import cupy as cp
    81	
    82	        env.update(
    83	            cupy=cp.__version__,
    84	            cuda_runtime=int(cp.cuda.runtime.runtimeGetVersion()),
    85	            cuda_driver=int(cp.cuda.runtime.driverGetVersion()),
    86	        )
    87	        if backend == "cupy":
    88	            device = cp.cuda.Device()
    89	            env["cuda_device_id"] = int(device.id)
    90	            try:
    91	                name = cp.cuda.runtime.getDeviceProperties(device.id)["name"]
    92	                env["cuda_device_name"] = (
    93	                    name.decode() if isinstance(name, bytes) else str(name)
    94	                )
    95	            except Exception:
    96	                pass
    97	    except Exception:
    98	        pass
    99	    return env
