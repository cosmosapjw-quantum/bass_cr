   101	
   102	def ndarray_digest(array) -> str:
   103	    """Typed SHA-256 over dtype, shape, and C-order numerical bytes."""
   104	    arr = np.asarray(array)
   105	    if arr.dtype.hasobject or not np.isfinite(arr).all():
   106	        raise ValueError("finite non-object numerical array required")
   107	
   108	    h = hashlib.sha256()
   109	    h.update(b"BASS_CR_NDARRAY_SHA256_V1\0")
   110	    h.update(arr.dtype.str.encode("ascii") + b"\0")
   111	    h.update(
   112	        json.dumps(list(arr.shape), separators=(",", ":")).encode("ascii") + b"\0"
   113	    )
   114	
   115	    if arr.flags.c_contiguous:
   116	        raw = memoryview(arr).cast("B")
   117	        for offset in range(0, len(raw), HASH_CHUNK_BYTES):
   118	            h.update(raw[offset : offset + HASH_CHUNK_BYTES])
   119	    else:
   120	        for slab in arr:
   121	            h.update(np.ascontiguousarray(slab).view(np.uint8).tobytes())
   122	    return h.hexdigest()
   123	
   124	
   125	def weighted_norm(array, dv: float) -> float:
   126	    arr = np.asarray(array).reshape(-1)
   127	    partials = []
   128	    for offset in range(0, arr.size, NORM_CHUNK_ELEMENTS):
   129	        chunk = arr[offset : offset + NORM_CHUNK_ELEMENTS]
   130	        partials.append(float(np.vdot(chunk, chunk).real) * dv)
   131	    return math.fsum(partials)
   132	
   133	
   134	def validate_prepared(
   135	    prepared_dir: Path,
   136	    raw_cfg: dict,
   137	    expected_source_digest: str,
   138	) -> dict:
   139	    """Validate preparation through the canonical R3M13 loader, then add bindings."""
   140	    prepared_dir = Path(prepared_dir)
   141	    helper = load_r3m13_helper()
   142	
   143	    if getattr(helper, "EXPECTED_SOURCE_DIGEST", None) != expected_source_digest:
   144	        raise ValueError("R3M13 helper source pin mismatch")
   145	
   146	    # SSOT reuse: this verifies R3M13 status/source, dynamics_fingerprint,
   147	    # initial.npy file hash, grid shape, and dv exactly as R3M13 defined them.
   148	    state, receipt = helper.load_prepared(prepared_dir)
   149	
   150	    if receipt.get("schema") != "BASS_CR_R3M13_PREPARATION_V1":
   151	        raise ValueError("unexpected R3M13 preparation schema")
   152	    helper_sha = file_sha(R3M13_HELPER)
   153	    if receipt.get("script_sha256") != helper_sha:
   154	        raise ValueError("R3M13 helper script hash mismatch")
   155	    if canonical_json(receipt.get("config")) != canonical_json(raw_cfg):
   156	        raise ValueError("prepared-state canonical config differs from collision config")
   157	
   158	    dv = float(receipt["dv"])
   159	    norm = weighted_norm(state, dv)
   160	    if abs(norm - 1.0) > NORM_TOL:
   161	        raise ValueError("prepared state is not normalized in its grid measure")
   162	
   163	    return {
   164	        "receipt": receipt,
   165	        "receipt_sha256": file_sha(prepared_dir / "receipt.json"),
   166	        "state_file_sha256": file_sha(prepared_dir / "initial.npy"),
   167	        "array_digest": ndarray_digest(state),
   168	        "shape": list(state.shape),
   169	        "dtype": state.dtype.str,
   170	        "dv": dv,
   171	        "norm": norm,
   172	        "helper_sha256": helper_sha,
   173	    }
   174	
   175	
   176	class WitnessControlledTDLRunner(ControlledTDLRunner):
   177	    """Observe and bind the inherited initial state without modifying it."""
   178	
   179	    def __init__(
   180	        self,
   181	        cfg,
   182	        *,
   183	        collision_out: Path,
   184	        prepared_info: dict,
   185	        expected_source_digest: str,
   186	        instrumentation_sha256: str,
   187	    ):
   188	        self._witness_out = Path(collision_out)
   189	        self._prepared_info = prepared_info
   190	        self._expected_source_digest = expected_source_digest
   191	        self._instrumentation_sha256 = instrumentation_sha256
   192	        super().__init__(cfg)
   193	
   194	    def relaxed_initial(self):
   195	        psi, info = super().relaxed_initial()
   196	        host = np.asarray(asnumpy(psi))
   197	        internal_digest = ndarray_digest(host)
   198	        internal_norm = weighted_norm(host, self.dv)
   199	
   200	        prepared_env = self._prepared_info["receipt"].get("environment", {})
   201	        runtime_env = runtime_environment(self.backend)
   202	        # R3M13 records exactly these three fields. Extra CUDA/CuPy identity is
   203	        # bound separately across collision restarts below.
   204	        environment_match = all(
   205	            prepared_env.get(key) == runtime_env.get(key)
   206	            for key in ("python", "numpy", "backend")
   207	        )
   208	        digest_match = internal_digest == self._prepared_info["array_digest"]
   209	        norm_match = abs(internal_norm - 1.0) <= NORM_TOL
   210	        same = digest_match and environment_match and norm_match
   211	
   212	        witness = {
   213	            "schema": SCHEMA,
   214	            "status": (
   215	                "PASS_BYTE_IDENTICAL_INTERNAL_INITIAL_TO_PREPARED"
   216	                if same
   217	                else "FAIL_INTERNAL_INITIAL_NOT_IDENTICAL"
   218	            ),
   219	            "numerical_state_substituted": False,
   220	            "numerical_state_renormalized": False,
   221	            "collision_propagation_started_when_written": False,
   222	            "expected_source_digest": self._expected_source_digest,
   223	            "actual_source_digest": source_digest(),
   224	            "instrumentation_sha256": self._instrumentation_sha256,
   225	            "r3m13_helper_sha256": self._prepared_info["helper_sha256"],
   226	            "prepared_receipt_sha256": self._prepared_info["receipt_sha256"],
   227	            "prepared_state_file_sha256": self._prepared_info["state_file_sha256"],
   228	            "prepared_array_digest": self._prepared_info["array_digest"],
   229	            "internal_array_digest": internal_digest,
   230	            "array_digest_match": digest_match,
   231	            "prepared_norm": self._prepared_info["norm"],
   232	            "internal_norm": internal_norm,
   233	            "norm_match": norm_match,
   234	            "prepared_environment": prepared_env,
   235	            "runtime_environment": runtime_env,
   236	            "environment_match": environment_match,
   237	            "shape": list(host.shape),
   238	            "dtype": host.dtype.str,
   239	            "dv": self.dv,
   240	            "backend": self.backend,
   241	            "enriched_config_hash": config_hash(self.cfg),
   242	            "initial_metadata": info,
   243	            "physical_rate_evaluated": False,
   244	            "bgrid": "NO_GO",
   245	            "claim_scope": "IDENTITY_BINDING_ONLY_NOT_CONVERGENCE",
   246	        }
   247	        atomic_json(self._witness_out / "r3m14_initial_binding.json", witness)
   248	
   249	        if not same:
   250	            raise ValueError(
   251	                "actual collision initial state is not "
   252	                "byte-identical/environment-bound to prepared initial state"
   253	            )
   254	        # Critical noninterference property: return the inherited object exactly.
   255	        return psi, info
