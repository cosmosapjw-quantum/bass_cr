     1	#!/usr/bin/env python3
     2	"""Evaluate preregistered A3/B3 spatial pair and raw h-dt interaction."""
     3	from __future__ import annotations
     4	
     5	import argparse
     6	import json
     7	import math
     8	from pathlib import Path
     9	
    10	from cr_repro.r3m11 import source_digest
    11	from scripts import r3m27_b3_execute as base
    12	from scripts import r3m28_execute as run
    13	from scripts.r3m17_temporal import validate_result, validate_witness
    14	
    15	ROOT = Path(__file__).resolve().parents[1]
    16	CHANNELS = ('P1', 'P2', 'P3')
    17	SCREEN = .003
    18	B3_RAW = Path('/mnt/sn850x2t/bass_cr_r3m27_20260924/B3/collision/result.json')
    19	B3_RAW_SHA = '7360649d2148420c3eebdb32f05938a3ee4afc048655e300a6b19b1e12f7dbce'
    20	B3_CONFIG = ROOT / 'configs/r3m27/B3.json'
    21	
    22	
    23	def screen(a1: dict, b1: dict, a3: dict, b3: dict) -> dict:
    24	    """Arithmetic only; callers must establish raw scientific identities."""
    25	    rows = {}
    26	    for channel in CHANNELS:
    27	        values = [row.get(channel) for row in (a1, b1, a3, b3)]
    28	        if any(isinstance(v, bool) or not isinstance(v, (float, int)) or
    29	               not math.isfinite(v) or v <= 0 for v in values):
    30	            raise ValueError('finite positive channel probabilities required')
    31	        old = b1[channel]-a1[channel]
    32	        fine = b3[channel]-a3[channel]
    33	        interaction = fine-old
    34	        relative = abs(fine)/b3[channel]
    35	        rows[channel] = dict(A1=a1[channel], B1=b1[channel],
    36	            A3=a3[channel], B3=b3[channel],
    37	            old_h_gap=old, fine_h_gap=fine,
    38	            raw_h_dt_interaction=interaction,
    39	            pair_relative_to_B3=relative,
    40	            pair_screen_pass=relative <= SCREEN,
    41	            denominator_B3=b3[channel],
    42	            absolute_screen_threshold=SCREEN*b3[channel])
    43	    pair_pass = all(v['pair_screen_pass'] for v in rows.values())
    44	    return dict(status='SPATIAL_PAIR_SCREEN_PASS_BUDGET_OPEN' if pair_pass else
    45	                'SPATIAL_PAIR_SCREEN_NO_GO', channels=rows,
    46	                pair_screen_relative=SCREEN,
    47	                pair_is_validated_spatial_error_estimate=False,
    48	                h_dt_interaction_is_validated_error_estimate=False,
    49	                h_dt_accounting='OPEN_COUNT_ONCE_IN_FUTURE_VALIDATED_ENVELOPE_OR_SEPARATELY',
    50	                A3_time_error='NOT_INDEPENDENTLY_VALIDATED',
    51	                subcell_translation_full_component='OPEN',
    52	                spatial_budget='OPEN', production_admission=False)
    53	
    54	
    55	def evaluate(root: Path, contract: Path) -> dict:
    56	    root, contract = Path(root).absolute(), Path(contract).absolute()
    57	    plan = base.read(contract)
    58	    if root != Path(plan['output_root']) or base.sha(contract) != base.read(root/'RUN.json')['contract_sha256']:
    59	        raise ValueError('A3 root/contract SHA binding mismatch')
    60	    run.validate_plan(plan)
    61	    design = base.read(run.DESIGN)
    62	    if (base.sha(run.DESIGN) != plan['design_sha256'] or
    63	            design['spatial_pair_screen_relative'] != SCREEN or
    64	            design['actual_dt'] != .00624946176119497):
    65	        raise ValueError('spatial design/criterion changed after A3')
    66	    if source_digest() != run.SOURCE:
    67	        raise ValueError('numerical source changed')
    68	    if base.sha(run.A1_RESULT) != run.A1_RESULT_SHA or base.sha(run.B1_RESULT) != run.B1_RESULT_SHA:
    69	        raise ValueError('historical A1/B1 raw result changed')
    70	    if base.sha(run.B3_RESULT) != run.B3_RESULT_SHA or base.sha(B3_RAW) != B3_RAW_SHA:
    71	        raise ValueError('R3M27 B3 evidence changed')
    72	    cfg_a1 = base.read(run.A1_CONFIG)
    73	    cfg_b1 = base.read(ROOT/'configs/r3m16/B1.json')
    74	    cfg_a3 = base.read(run.CONFIG)
    75	    cfg_b3 = base.read(B3_CONFIG)
    76	    a1 = validate_result(base.read(run.A1_RESULT), cfg_a1)
    77	    b1 = validate_result(base.read(run.B1_RESULT), cfg_b1)
    78	    b3 = validate_result(base.read(B3_RAW), cfg_b3)
    79	    prior_b3 = base.read(run.B3_RESULT)
    80	    if prior_b3['status'] != 'TEMPORAL_ESTIMATE_VALIDATED_FOR_FIXED_H_SELECTED_SPANS':
    81	        raise ValueError('B3 time evidence did not pass')
    82	    for k in ('P1', 'P2', 'P3', 'actual_dt', 'nstep'):
    83	        if b3[k] != prior_b3['raw_B3_row'][k]:
    84	            raise ValueError('raw B3 result differs from R3M27 evaluator')
    85	    complete = base.read(root/'COMPLETE.json')
    86	    result_path = root/'collision/result.json'
    87	    witness_path = root/'collision/r3m14_initial_binding.json'
    88	    if (complete['status'] != 'COMPLETE' or complete['nstep'] != run.NSTEP or
    89	            complete['result_sha256'] != base.sha(result_path) or
    90	            complete['contract_sha256'] != base.sha(contract)):
    91	        raise ValueError('A3 final result not bound to completed contract')
    92	    a3 = validate_result(base.read(result_path), cfg_a3)
    93	    witness = base.read(witness_path)
    94	    validate_witness(witness, cfg_a3, run.INITIAL_SHA)
    95	    prepared = run._prepared(root, cfg_a3)
    96	    if witness['prepared_receipt_sha256'] != prepared['receipt_sha256']:
    97	        raise ValueError('A3 witness does not bind fresh preparation receipt')
    98	    if a3['nstep'] != b3['nstep'] or a3['actual_dt'] != b3['actual_dt']:
    99	        raise ValueError('A3/B3 actual dt/horizon differs')
   100	    if a1['actual_dt'] != b1['actual_dt']:
   101	        raise ValueError('A1/B1 coarse actual dt differs')
   102	    arithmetic = screen(a1, b1, a3, b3)
   103	    return dict(schema='R3M28_SPATIAL_HDT_EVALUATION_V1', **arithmetic,
   104	        claim_scope='SAME_PHYSICAL_HORIZON_H025_H020_SELECTED_SPANS_RAW_PAIR_ONLY',
   105	        original_A3_row=a3, original_B3_row=b3,
   106	        coarse_actual_dt=a1['actual_dt'], fine_actual_dt=a3['actual_dt'],
   107	        source_digest=source_digest(), contract_sha256=base.sha(contract),
   108	        design_sha256=base.sha(run.DESIGN),
   109	        input_sha256=dict(A1=run.A1_RESULT_SHA, B1=run.B1_RESULT_SHA,
   110	            A3=base.sha(result_path), B3=B3_RAW_SHA,
   111	            witness=base.sha(witness_path),
   112	            preparation_receipt=prepared['receipt_sha256']),
   113	        certified_bound=None, all_bound='OPEN', b_grid='NO_GO')
   114	
   115	
   116	def main() -> None:
   117	    parser = argparse.ArgumentParser(description=__doc__)
   118	    parser.add_argument('--root', type=Path, required=True)
   119	    parser.add_argument('--contract', type=Path, required=True)
   120	    parser.add_argument('--out', type=Path, required=True)
   121	    args = parser.parse_args()
   122	    value = evaluate(args.root, args.contract)
   123	    base.publish(args.out, value)
   124	    print(json.dumps(dict(output=str(args.out), status=value['status'],
   125	                          production_admission=False)))
   126	
   127	
   128	if __name__ == '__main__':
   129	    main()
     1	import pytest
     2	
     3	from scripts.r3m28_spatial import screen
     4	
     5	
     6	def _rows(a3=0.00807):
     7	    return (
     8	        {'P1': .00587, 'P2': .00733, 'P3': .007825},
     9	        {'P1': .00606, 'P2': .00756, 'P3': .008063},
    10	        {'P1': .00608, 'P2': .00758, 'P3': a3},
    11	        {'P1': .00609, 'P2': .00759, 'P3': .008089},
    12	    )
    13	
    14	
    15	def test_pair_screen_pass_does_not_admit_spatial_budget():
    16	    result = screen(*_rows())
    17	    assert result['status'] == 'SPATIAL_PAIR_SCREEN_PASS_BUDGET_OPEN'
    18	    assert result['spatial_budget'] == 'OPEN'
    19	    assert not result['pair_is_validated_spatial_error_estimate']
    20	    assert result['channels']['P3']['raw_h_dt_interaction'] == pytest.approx(
    21	        (.008089-.00807)-(.008063-.007825))
    22	
    23	
