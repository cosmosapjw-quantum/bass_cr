#!/usr/bin/env python3
"""Freeze and validate one bounded-work contract without keeping a ledger."""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path
from typing import Any, Mapping


DECISIONS = {
    "COMPLETE_ACCEPTANCE",
    "CONTINUE_CHANGED_CELL",
    "HUMAN_ADJUDICATE",
    "DEFER_FOLLOWUP",
    "STOP_INVALID",
    "STOP_BUDGET",
}
FAILURE_CLASSES = {
    "FORBIDDEN_ESCAPE",
    "CONSERVATIVE_FALSE_POSITIVE",
    "OUTSIDE_FROZEN_ACCEPTANCE",
    "REGISTERED_ACCEPTANCE_FAILURE",
    "BUDGET_EXHAUSTED",
}
BUDGET_LIMITS = {
    "review_rounds": 1,
    "repair_closeout_rounds": 1,
    "same_failure_retries": 1,
    "metacognitive_passes": 1,
    "active_agents": 4,
}
MAX_ACCEPTANCE_CRITERIA = 64
MAX_CONTRACT_BYTES = 65536
UNFROZEN_SENTINELS = {None, "", "UNFROZEN", "RUN_FREEZE_TO_POPULATE"}


def canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    ).encode("utf-8")


def canonical_sha256(value: object) -> str:
    return hashlib.sha256(canonical_bytes(value)).hexdigest()


def _nonempty_string(value: object) -> bool:
    return isinstance(value, str) and bool(value.strip())


def frozen_scope(contract: Mapping[str, object]) -> dict[str, object]:
    return {
        "acceptance": contract.get("acceptance"),
        "cell_dependents": contract.get("cell_dependents"),
        "cells": contract.get("cells"),
    }


def dependent_closure(
    seeds: set[str],
    dependents: Mapping[str, list[str]],
) -> set[str]:
    closure = set(seeds)
    pending = list(seeds)
    while pending:
        cell = pending.pop()
        for dependent in dependents.get(cell, []):
            if dependent not in closure:
                closure.add(dependent)
                pending.append(dependent)
    return closure


def validate_contract(contract: object) -> list[str]:
    errors: list[str] = []
    if not isinstance(contract, Mapping):
        return ["contract must be a JSON object"]
    if len(canonical_bytes(contract)) > MAX_CONTRACT_BYTES:
        errors.append(
            f"contract may contain at most {MAX_CONTRACT_BYTES} canonical UTF-8 bytes"
        )
    if contract.get("schema_version") != 1:
        errors.append("schema_version must equal 1")
    for field in ("work_unit", "deliverable"):
        if not _nonempty_string(contract.get(field)):
            errors.append(f"{field} must be a non-empty string")

    acceptance = contract.get("acceptance")
    if not isinstance(acceptance, Mapping):
        errors.append("acceptance must be an object")
        criteria: list[object] = []
    else:
        criteria_value = acceptance.get("criteria")
        criteria = criteria_value if isinstance(criteria_value, list) else []
        if not criteria:
            errors.append("acceptance.criteria must be a non-empty finite list")
        elif len(criteria) > MAX_ACCEPTANCE_CRITERIA:
            errors.append(
                f"acceptance.criteria may contain at most {MAX_ACCEPTANCE_CRITERIA} entries"
            )
    frozen_hash = contract.get("acceptance_sha256")
    if not isinstance(frozen_hash, str) or frozen_hash != canonical_sha256(
        frozen_scope(contract)
    ):
        errors.append("acceptance_sha256 does not match frozen scope")

    criterion_ids: set[str] = set()
    criterion_cells: list[tuple[int, str]] = []
    for index, criterion in enumerate(criteria):
        if not isinstance(criterion, Mapping):
            errors.append(f"acceptance.criteria[{index}] must be an object")
            continue
        criterion_id = criterion.get("id")
        if not _nonempty_string(criterion_id):
            errors.append(f"acceptance.criteria[{index}].id is missing")
        elif str(criterion_id) in criterion_ids:
            errors.append(f"acceptance criterion is duplicated: {criterion_id}")
        else:
            criterion_ids.add(str(criterion_id))
        for field in ("cell", "evidence"):
            if not _nonempty_string(criterion.get(field)):
                errors.append(f"acceptance.criteria[{index}].{field} is missing")
        if _nonempty_string(criterion.get("cell")):
            criterion_cells.append((index, str(criterion["cell"])))

    cells = contract.get("cells")
    if not isinstance(cells, Mapping) or not cells:
        errors.append("cells must be a non-empty object")
        cell_names: set[str] = set()
    else:
        cell_names = {str(name) for name in cells}
        for name, paths in cells.items():
            if not _nonempty_string(name):
            if not _nonempty_string(name):
                errors.append("cell name must be a non-empty string")
            if (
                not isinstance(paths, list)
                or not paths
                or any(not _nonempty_string(path) for path in paths)
            ):
                errors.append(f"cell {name} must list one or more paths")
            elif len(paths) != len(set(map(str, paths))):
                errors.append(f"cell {name} must not contain duplicate paths")
    for index, cell in criterion_cells:
        if cell not in cell_names:
            errors.append(
                f"acceptance.criteria[{index}].cell references undeclared cell: {cell}"
            )

    cell_dependents = contract.get("cell_dependents")
    normalized_dependents: dict[str, list[str]] = {}
    if not isinstance(cell_dependents, Mapping) or set(map(str, cell_dependents)) != cell_names:
        errors.append("cell_dependents must contain exactly the declared cell names")
    else:
        for raw_name, raw_values in cell_dependents.items():
            name = str(raw_name)
            if (
                not isinstance(raw_values, list)
                or any(not _nonempty_string(value) for value in raw_values)
                or len(raw_values) != len(set(map(str, raw_values)))
            ):
                errors.append(f"cell_dependents.{name} must be a unique string list")
                continue
            values = [str(value) for value in raw_values]
            for value in values:
                if value not in cell_names:
                    errors.append(
                        f"cell_dependents.{name} references undeclared cell: {value}"
                    )
                if value == name:
                    errors.append(f"cell_dependents.{name} must not depend on itself")
            normalized_dependents[name] = values
    changed_cells = contract.get("changed_cells")
    changed_cell_names: set[str] = set()
    if not isinstance(changed_cells, list):
        errors.append("changed_cells must be a list")
    else:
        if len(changed_cells) != len(set(map(str, changed_cells))):
            errors.append("changed_cells must not contain duplicates")
        for cell in changed_cells:
            if str(cell) not in cell_names:
                errors.append(f"changed_cells contains undeclared cell: {cell}")
            else:
                changed_cell_names.add(str(cell))
        if set(normalized_dependents) == cell_names:
            required = dependent_closure(changed_cell_names, normalized_dependents)
            missing = sorted(required - changed_cell_names)
            if missing:
                errors.append(
                    "changed_cells omits declared dependent closure: "
                    + ", ".join(missing)
                )

    budgets = contract.get("budgets")
    normalized_budgets: dict[str, tuple[int, int]] = {}
    if not isinstance(budgets, Mapping) or set(budgets) != set(BUDGET_LIMITS):
        errors.append("budgets must contain exactly the registered budget names")
    else:
        for name, maximum in BUDGET_LIMITS.items():
            budget = budgets.get(name)
            if not isinstance(budget, Mapping) or set(budget) != {"limit", "used"}:
                errors.append(f"{name} must contain exactly limit and used")
                continue
            limit = budget.get("limit")
            used = budget.get("used")
            if type(limit) is not int or limit > maximum or limit < 0:
                errors.append(f"{name} limit must be at most {maximum}")
            if type(used) is not int or type(limit) is not int or not 0 <= used <= limit:
                errors.append(f"{name} used must be between zero and its limit")
            if type(limit) is int and type(used) is int and 0 <= used <= limit:
                normalized_budgets[name] = (limit, used)

    meta = contract.get("metacognitive_output")
    if not isinstance(meta, Mapping):
        errors.append("metacognitive_output must be an object")
    else:
        if set(meta) != {"self_ask", "observable_action"}:
            errors.append(
                "metacognitive_output may contain only self_ask and observable_action"
            )
        if not _nonempty_string(meta.get("self_ask")):
            errors.append("metacognitive_output.self_ask is missing")
        if not _nonempty_string(meta.get("observable_action")):
            errors.append("metacognitive_output.observable_action is missing")

    decision = contract.get("decision")
    if decision not in DECISIONS:
        errors.append(f"decision is not registered: {decision}")

    finding = contract.get("finding")
    if finding is None:
        if decision not in {"CONTINUE_CHANGED_CELL", "COMPLETE_ACCEPTANCE"}:
            errors.append(
                "a contract without a finding requires CONTINUE_CHANGED_CELL or "
                "COMPLETE_ACCEPTANCE"
            )
    else:
        if not isinstance(finding, Mapping):
            errors.append("finding must be an object or null")
        else:
            failure_class = finding.get("failure_class")
            disposition = finding.get("disposition")
            criterion_id = finding.get("acceptance_criterion_id")
            if failure_class not in FAILURE_CLASSES:
                errors.append(f"finding failure_class is not registered: {failure_class}")
            if criterion_id is not None and criterion_id not in criterion_ids:
                errors.append(
                    f"finding references unknown acceptance criterion: {criterion_id}"
                )
            if disposition not in DECISIONS:
                errors.append(f"finding disposition is not registered: {disposition}")
            elif decision != disposition:
                errors.append("decision must equal finding disposition")
            if disposition == "COMPLETE_ACCEPTANCE":
                errors.append("a contract with a finding cannot COMPLETE_ACCEPTANCE")
            requires_criterion = failure_class in {
                "FORBIDDEN_ESCAPE",
                "CONSERVATIVE_FALSE_POSITIVE",
                "REGISTERED_ACCEPTANCE_FAILURE",
            }
            if requires_criterion and criterion_id not in criterion_ids:
                errors.append(f"{failure_class} requires a registered criterion")
            if failure_class in {"OUTSIDE_FROZEN_ACCEPTANCE", "BUDGET_EXHAUSTED"} and criterion_id is not None:
                errors.append(f"{failure_class} must not name an acceptance criterion")
            if failure_class in {"FORBIDDEN_ESCAPE", "REGISTERED_ACCEPTANCE_FAILURE"} and disposition not in {
                "CONTINUE_CHANGED_CELL",
                "STOP_INVALID",
            }:
                errors.append(
                    f"{failure_class} requires CONTINUE_CHANGED_CELL or STOP_INVALID"
                )
            if failure_class == "CONSERVATIVE_FALSE_POSITIVE" and disposition not in {
                "HUMAN_ADJUDICATE",
                "DEFER_FOLLOWUP",
            }:
                errors.append(
                    "CONSERVATIVE_FALSE_POSITIVE requires HUMAN_ADJUDICATE or "
                    "DEFER_FOLLOWUP"
                )
            if failure_class == "OUTSIDE_FROZEN_ACCEPTANCE" and disposition != "DEFER_FOLLOWUP":
                errors.append("OUTSIDE_FROZEN_ACCEPTANCE requires DEFER_FOLLOWUP")
            if failure_class == "BUDGET_EXHAUSTED" and disposition != "STOP_BUDGET":
                errors.append("BUDGET_EXHAUSTED requires STOP_BUDGET")
            repair_budget = normalized_budgets.get("repair_closeout_rounds")
            if disposition == "CONTINUE_CHANGED_CELL" and repair_budget is not None:
                limit, used = repair_budget
                if used >= limit:
                    errors.append(
                        "CONTINUE_CHANGED_CELL requires remaining repair_closeout_rounds"
                    )
            if disposition == "STOP_INVALID" and repair_budget is not None:
                limit, used = repair_budget
                if used < limit:
                    errors.append(
                        "STOP_INVALID requires exhausted repair_closeout_rounds"
                    )
            if failure_class == "BUDGET_EXHAUSTED":
                budget_name = finding.get("budget_name")
                if budget_name not in BUDGET_LIMITS:
                    errors.append("BUDGET_EXHAUSTED requires a registered budget_name")
                elif budget_name in normalized_budgets:
                    limit, used = normalized_budgets[str(budget_name)]
                    if used < limit:
                        errors.append(
                            "STOP_BUDGET requires the named budget to be exhausted"
                        )
    return errors


def load_json(path: Path) -> Any:
    with path.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def write_json(path: Path, payload: object) -> None:
    path.write_text(
        json.dumps(payload, indent=2, ensure_ascii=False, sort_keys=True) + "\n",
        encoding="utf-8",
    )


