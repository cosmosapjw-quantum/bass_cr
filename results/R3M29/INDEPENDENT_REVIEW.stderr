    30	    def relaxed_initial(self):
    31	        mode=self.cfg.get('initial_state','imag_time')
    32	        psi=self.xp.asarray(one_s(asnumpy(self.X),asnumpy(self.Y),asnumpy(self.Z)),dtype=self.xp.complex128)
    33	        psi=self.normalize(psi)
    34	        if mode=='analytic': return psi,{'mode':'analytic','energy_Eh':self.target_energy(psi),'steps':0}
    35	        tau=float(self.cfg.get('imag_dt',0.05)); n=int(self.cfg.get('imag_steps',300)); kin=self.xp.exp(-0.5*tau*self.k2)
    36	        vh=self.xp.exp(-0.5*tau*self.Vtarget)
    37	        last=None
    38	        for j in range(n):
    39	            psi=vh*psi; psi=self.xp.fft.ifftn(kin*self.xp.fft.fftn(psi)); psi=vh*psi; psi=self.normalize(psi)
