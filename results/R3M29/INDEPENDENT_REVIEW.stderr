    87	            if done%stride==0 or done==stop:
    88	                self._save_checkpoint(out,psi,{'config_hash':ident,'done':done,'nstep':self.nstep,'initial':init,'norm':self.norm(psi),'backend':self.backend})
    89	        if done<self.nstep: return {'status':'checkpoint','done':done,'nstep':self.nstep,'backend':self.backend}
    90	        analysis=self.analyze(psi); result={'status':'completed','config':self.cfg,'backend':self.backend,'nstep':self.nstep,'dt_actual':self.dt_actual,'v_au':self.v,'initial':init,'analysis':analysis,'seconds_last_call':time.time()-tic,
    91	          'claim':'P_bound is truncated at project_nmax; this is an independent paper-based implementation, not Nichols code reproduction'}
