     1	from __future__ import annotations
     2	from dataclasses import dataclass
     3	import numpy as np
     4	
     5	@dataclass(frozen=True)
     6	class GridSpec:
     7	    xlim: tuple[float,float]; ylim: tuple[float,float]; zlim: tuple[float,float]; dx: float
     8	    @staticmethod
     9	    def from_dict(d):
    10	        return GridSpec(tuple(map(float,d['xlim'])),tuple(map(float,d['ylim'])),tuple(map(float,d['zlim'])),float(d['dx']))
    11	    def shape(self):
    12	        out=[]
    13	        for lohi in [self.xlim,self.ylim,self.zlim]:
    14	            L=lohi[1]-lohi[0]; n=round(L/self.dx)
    15	            if abs(n*self.dx-L)>1e-9: raise ValueError('box lengths must be integer multiples of dx for cell-centered grid')
    16	            out.append(int(n))
    17	        return tuple(out)
    18	    def axes(self,xp=np):
    19	        axes=[]
    20	        for (lo,hi),n in zip([self.xlim,self.ylim,self.zlim],self.shape()):
    21	            axes.append(xp.asarray(lo+(np.arange(n)+0.5)*self.dx))
    22	        return tuple(axes)
    23	    @property
    24	    def dv(self): return self.dx**3
    25	
    26	def k2_grid(spec:GridSpec,xp):
    27	    nx,ny,nz=spec.shape(); dx=spec.dx
    28	    kx=2*xp.pi*xp.fft.fftfreq(nx,d=dx); ky=2*xp.pi*xp.fft.fftfreq(ny,d=dx); kz=2*xp.pi*xp.fft.fftfreq(nz,d=dx)
    29	    return kx[:,None,None]**2+ky[None,:,None]**2+kz[None,None,:]**2
    30	
    31	def absorber_mask(spec:GridSpec,xp,width=4.0,power=0.125):
    32	    if width<=0: return xp.ones(spec.shape(),dtype=float)
    33	    axes=spec.axes(xp); masks=[]
    34	    for a,(lo,hi) in zip(axes,[spec.xlim,spec.ylim,spec.zlim]):
    35	        d=xp.minimum(a-lo,hi-a)
    36	        u=xp.clip(d/width,0,1)
    37	        m=xp.where(u<1,xp.sin(0.5*xp.pi*u)**power,1.0)
    38	        masks.append(m)
    39	    return masks[0][:,None,None]*masks[1][None,:,None]*masks[2][None,None,:]
