     1	#!/usr/bin/env python3
     2	"""Bounded local Coulomb singular-cell and trajectory-phase discriminator.
     3	
     4	This never propagates a state or changes the production representation.
     5	"""
     6	from __future__ import annotations
     7	
     8	import argparse
     9	import hashlib
    10	import json
    11	import math
    12	import time
    13	from pathlib import Path
    14	
    15	import numpy as np
    16	from numpy.polynomial.legendre import leggauss
    17	from scipy.integrate import dblquad
    18	
    19	
    20	ROOT = Path(__file__).resolve().parents[1]
    21	DESIGN = ROOT / "results/R3M29/DESIGN.json"
    22	
    23	
    24	def sha(path: Path) -> str:
    25	    with Path(path).open("rb") as stream:
    26	        return hashlib.file_digest(stream, "sha256").hexdigest()
    27	
    28	
    29	def bind_design() -> dict:
    30	    design = json.loads(DESIGN.read_text())
    31	    if design["input_head"] != "8656736dd1b45b748b0669f4a7dafdb71787e032":
    32	        raise ValueError("unrecognized input HEAD")
    33	    for relative, expected in design["input_sha256"].items():
    34	        if sha(ROOT / relative) != expected:
    35	            raise ValueError(f"frozen input changed: {relative}")
    36	    if (design["nstep"] != 7172 or design["h_values"] != [0.25, 0.2]
    37	            or design["singular_cell_phases"] != [0.0, 0.25, 0.5]
    38	            or design["phase_bins"] != 32):
    39	        raise ValueError("unexpected diagnostic design")
    40	    return design
    41	
    42	
    43	def integrand(y: float, x: float, alpha: float) -> float:
    44	    rho = math.hypot(x, y)
    45	    if rho == 0:
    46	        return math.inf
    47	    return math.asinh((1.0-alpha)/rho) + math.asinh(alpha/rho)
    48	
    49	
    50	def cell_average_reference(alpha: float) -> tuple[float, float]:
    51	    """Independent adaptive 2-D integration after exact z integration."""
    52	    if not 0 <= alpha <= 1:
    53	        raise ValueError("phase outside one cell")
    54	    return dblquad(lambda y, x: integrand(y, x, alpha), 0, 1,
    55	                   lambda _x: 0, lambda _x: 1, epsabs=1e-9, epsrel=1e-9)
    56	
    57	
    58	def cell_average_gl(alpha: float, order: int) -> float:
    59	    if not 0 <= alpha <= 1 or order < 2:
    60	        raise ValueError("invalid phase or quadrature order")
    61	    nodes, weights = leggauss(order)
    62	    nodes = (nodes+1)/2
    63	    weights = weights/2
    64	    rho = np.hypot(nodes[:, None], nodes[None, :])
    65	    value = np.arcsinh((1-alpha)/rho) + np.arcsinh(alpha/rho)
    66	    return float(np.sum(weights[:, None]*weights[None, :]*value))
    67	
    68	
    69	def midpoint(alpha: float) -> float:
    70	    if not 0 <= alpha <= 1:
    71	        raise ValueError("phase outside one cell")
    72	    return 1/math.sqrt(0.5**2+0.5**2+(0.5-alpha)**2)
    73	
    74	
    75	def phase_counts(h: float, nstep: int, z_start: float, z_stop: float,
    76	                 bins: int) -> list[int]:
    77	    if h <= 0 or nstep <= 0 or bins <= 0:
    78	        raise ValueError("positive geometry required")
    79	    indices = np.arange(nstep, dtype=np.float64)
    80	    z_mid = z_start + (indices+0.5)*(z_stop-z_start)/nstep
    81	    phase = np.mod((z_mid-z_start)/h, 1.0)
    82	    return np.histogram(phase, bins=bins, range=(0, 1))[0].astype(int).tolist()
    83	
    84	
    85	def evaluate() -> dict:
    86	    start = time.monotonic()
    87	    d = bind_design()
    88	    observed = json.loads((ROOT / "results/R3M28/SPATIAL_EVALUATION.json").read_text())
    89	    if observed["status"] != "SPATIAL_PAIR_SCREEN_NO_GO":
    90	        raise ValueError("R3M28 spatial trigger changed")
    91	    for relative, h in (("configs/r3m28/A3.json", 0.25),
    92	                        ("configs/r3m27/B3.json", 0.2)):
    93	        cfg = json.loads((ROOT/relative).read_text())
    94	        grid = cfg["grid"]
    95	        if (grid["dx"] != h or cfg["b"] != 2.0 or
    96	                grid["xlim"][0] != -30 or grid["ylim"][0] != -30 or
    97	                grid["zlim"][0] != d["z_start"] or
    98	                cfg["z_start"] != d["z_start"] or cfg["z_stop"] != d["z_stop"] or
    99	                not math.isclose((cfg["b"]-grid["xlim"][0])/h,
   100	                                 round((cfg["b"]-grid["xlim"][0])/h), abs_tol=1e-12)):
   101	            raise ValueError("projectile/target vertex phase geometry changed")
   102	    rows = []
   103	    for alpha in d["singular_cell_phases"]:
   104	        reference, reported_error = cell_average_reference(alpha)
   105	        values = {str(n): cell_average_gl(alpha, n) for n in (64, 128, 256)}
   106	        relative = abs(values["256"]-reference)/reference
   107	        if relative > d["quadrature_relative_tolerance"]:
   108	            raise ArithmeticError("local cell quadrature did not converge")
   109	        point = midpoint(alpha)
   110	        rows.append(dict(alpha=alpha, h_times_cell_mean=reference,
   111	                         h_times_midpoint=point, midpoint_minus_cell_mean_relative=(point-reference)/reference,
   112	                         adaptive_reported_absolute_error=reported_error,
   113	                         gauss_legendre=values, gl256_relative_to_adaptive=relative))
   114	    occupancies = {}
   115	    for h in d["h_values"]:
   116	        counts = phase_counts(h, d["nstep"], d["z_start"], d["z_stop"], d["phase_bins"])
   117	        occupancies[str(h)] = dict(counts=counts, minimum=min(counts), maximum=max(counts),
   118	                                   maximum_absolute_fraction_from_uniform=max(abs(c/d["nstep"]-1/d["phase_bins"])
   119	                                                                      for c in counts))
   120	    first = np.asarray(occupancies[str(d["h_values"][0])]["counts"], float)/d["nstep"]
   121	    second = np.asarray(occupancies[str(d["h_values"][1])]["counts"], float)/d["nstep"]
   122	    tv = float(0.5*np.abs(first-second).sum())
   123	    min_bias = min(abs(r["midpoint_minus_cell_mean_relative"]) for r in rows)
   124	    selected = (tv <= d["phase_total_variation_threshold"]
   125	                and min_bias >= d["minimum_all_phase_local_midpoint_bias"])
   126	    wall = time.monotonic()-start
   127	    if wall > d["max_cpu_wall_seconds"]:
   128	        raise TimeoutError("bounded local diagnostic wall exceeded")
   129	    return dict(schema="R3M29_COULOMB_CELL_RESULT_V1",
   130	                status=d["decision_if_pass"] if selected else d["decision_if_fail"],
   131	                design_sha256=sha(DESIGN), input_head=d["input_head"],
   132	                input_sha256=d["input_sha256"], local_cell_rows=rows,
   133	                actual_midpoint_phase_histograms=occupancies,
   134	                phase_histogram_total_variation=tv,
   135	                minimum_local_midpoint_bias=min_bias,
   136	                local_1_over_r_cell_mean_scaling="h^-1",
   137	                h_values=d["h_values"], nstep=d["nstep"],
   138	                x_y_nuclear_vertex_alignment="VERIFIED_FOR_TARGET_AND_PROJECTILE_B2",
   139	                cpu_wall_seconds=wall, gpu_runs=0, new_preparations=0,
   140	                new_full_collisions=0,
   141	                causal_attribution_of_final_capture_gap="NOT_ESTABLISHED",
   142	                full_spatial_error_estimate="OPEN",
   143	                representation_decision="PRIORITIZE_CELL_AVERAGED_POINT_COULOMB_FOR_BOUNDED_SAME_H_VALIDATION_ONLY" if selected else "HOLD_UNRESOLVED",
   144	                production_representation_changed=False,
   145	                production_admission=False, all_bound="OPEN", b_grid="NO_GO")
   146	
   147	
   148	def main() -> None:
   149	    parser = argparse.ArgumentParser(description=__doc__)
   150	    parser.add_argument("--out", required=True, type=Path)
   151	    args = parser.parse_args()
   152	    value = evaluate()
   153	    args.out.parent.mkdir(parents=True, exist_ok=True)
   154	    with args.out.open("x") as stream:
   155	        json.dump(value, stream, indent=2, sort_keys=True, allow_nan=False)
   156	        stream.write("\n")
   157	    print(json.dumps(dict(status=value["status"], output=str(args.out))))
   158	
   159	
   160	if __name__ == "__main__":
   161	    main()
